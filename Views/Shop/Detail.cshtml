@model ProductViewModel
@{
    Layout = "_ShopLayout";
    ViewData["Title"] = Model.Name;
    var related = ViewBag.Related as List<ProductViewModel> ?? new();
    var reviews = ViewBag.Reviews as List<ShopProject.Models.DanhGium> ?? new();
    var avgRating = reviews.Any() ? reviews.Average(r => r.SoSao) : 5.0;
    var starDisplay = new string('★', (int)Math.Round(avgRating));
}

<main class="detail-page">
    <nav class="breadcrumb">
        <a asp-controller="Shop" asp-action="Index">Trang chủ</a>
        <span>/</span>
        <a asp-controller="Shop" asp-action="Index" asp-route-category="@Model.Category">@Model.Category</a>
        <span>/</span>
        <strong>@Model.Name</strong>
    </nav>

    @if (TempData["ReviewSuccess"] != null)
    {
        <div style="background:#dcfce7;color:#166534;padding:12px 16px;border-radius:10px;margin-bottom:16px;font-weight:500">
            ✓ @TempData["ReviewSuccess"]
        </div>
    }
    @if (TempData["ReviewError"] != null)
    {
        <div style="background:#fee2e2;color:#991b1b;padding:12px 16px;border-radius:10px;margin-bottom:16px;font-weight:500">
            ⚠ @TempData["ReviewError"]
        </div>
    }

    <div class="detail-layout">
        <section class="detail-gallery">
            <div class="main-detail-image"><img src="@Model.Image" alt="@Model.Name" /></div>
            <div class="detail-thumbs">
                <img src="@Model.Image" alt="@Model.Name" />
                <img src="@Model.Image" alt="@Model.Name" />
                <img src="@Model.Image" alt="@Model.Name" />
            </div>
        </section>

        <section class="detail-info">
            <span class="hero-tag">@Model.Category</span>
            <h1>@Model.Name</h1>
            <div class="detail-rating"><b>@starDisplay</b><span>@avgRating.ToString("0.0") (@reviews.Count đánh giá)</span></div>
            <strong class="detail-price">@Model.Price.ToString("N0") đ</strong>
            <p class="detail-description">Sản phẩm được may từ chất liệu cao cấp, mềm mại và thoáng mát. Thiết kế hiện đại, dễ phối đồ và phù hợp cho nhiều hoàn cảnh.</p>

            <div class="option-group">
                <label>Kích thước</label>
                <div class="size-options">
                    <button type="button" onclick="selectSize(this)">S</button>
                    <button type="button" class="selected" onclick="selectSize(this)">M</button>
                    <button type="button" onclick="selectSize(this)">L</button>
                    <button type="button" onclick="selectSize(this)">XL</button>
                </div>
            </div>

            <div class="option-group">
                <label>Màu sắc</label>
                <div class="color-options">
                    <button type="button" class="color-white" title="Trắng"></button>
                    <button type="button" class="color-beige" title="Be"></button>
                    <button type="button" class="color-black" title="Đen"></button>
                </div>
            </div>

            <div class="detail-actions">
                <div class="quantity detail-quantity">
                    <button type="button" onclick="changeDetailQty(-1)">−</button>
                    <strong id="detailQty">1</strong>
                    <button type="button" onclick="changeDetailQty(1)">＋</button>
                </div>
                <button type="button" class="checkout-button"
                        onclick="addDetailToCart('@Model.Id', '@Model.Name.Replace("'", "\\'")', @((int)Model.Price), '@Model.Image')">
                    Thêm vào giỏ hàng
                </button>
                <button type="button" class="detail-favorite" data-wishlist="@Model.Id">♡</button>
            </div>

            <div class="detail-benefits">
                <span>✓ Giao hàng miễn phí</span>
                <span>✓ Đổi trả trong 7 ngày</span>
                <span>✓ Thanh toán khi nhận hàng</span>
            </div>
        </section>
    </div>

    <section class="review-detail">
        <div class="section-heading">
            <div><span>ĐÁNH GIÁ</span><h2>Nhận xét từ khách hàng</h2></div>
            <b>@avgRating.ToString("0.0")/5</b>
        </div>

        <form method="post" asp-controller="Shop" asp-action="AddReview" style="background:#f8fafc;padding:18px;border-radius:12px;margin-bottom:20px;border:1px solid #e2e8f0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sanPhamId" value="@Model.Id" />
            <div style="display:flex;gap:12px;align-items:center;margin-bottom:10px;flex-wrap:wrap">
                <label style="font-weight:600">Đánh giá của bạn:</label>
                <select name="soSao" style="padding:8px 12px;border:1px solid #cbd5e1;border-radius:8px;background:#fff">
                    <option value="5">★★★★★ (5 sao - Tuyệt vời)</option>
                    <option value="4">★★★★☆ (4 sao - Hài lòng)</option>
                    <option value="3">★★★☆☆ (3 sao - Bình thường)</option>
                    <option value="2">★★☆☆☆ (2 sao - Không hài lòng)</option>
                    <option value="1">★☆☆☆☆ (1 sao - Rất tệ)</option>
                </select>
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap">
                <input name="noiDung" required placeholder="Chia sẻ cảm nhận của bạn về chất liệu, form dáng sản phẩm..."
                       style="flex:1;min-width:240px;padding:10px 14px;border:1px solid #cbd5e1;border-radius:8px" />
                <button type="submit" class="checkout-button" style="padding:10px 20px">Gửi đánh giá</button>
            </div>
        </form>

        @if (!reviews.Any())
        {
            <p style="color:#64748b;padding:12px 0">Chưa có đánh giá nào được duyệt cho sản phẩm này. Hãy là người đầu tiên nhận xét!</p>
        }
        else
        {
            foreach (var r in reviews)
            {
                var rStars = new string('★', Math.Clamp((int)r.SoSao, 1, 5));
                <article class="detail-review">
                    <div>
                        <b>@(r.NguoiDung?.HoTen ?? "Khách hàng")</b>
                        <small class="text-muted">@r.ThoiGianTao.ToString("dd/MM/yyyy")</small>
                    </div>
                    <div>
                        <span>@rStars</span>
                        <p class="mb-0 mt-1">@r.NoiDung</p>
                    </div>
                </article>
            }
        }
    </section>

    <section class="recommend-section">
        <div class="section-heading">
            <div><span>CÓ THỂ BẠN THÍCH</span><h2>Sản phẩm liên quan</h2></div>
        </div>
        <div class="recommend-grid">
            @foreach (var p in related)
            {
                <article class="product-card">
                    <a asp-controller="Shop" asp-action="Detail" asp-route-id="@p.Id" class="product-photo">
                        <img src="@p.Image" alt="@p.Name" />
                    </a>
                    <div class="product-info">
                        <small class="text-muted">@p.Category</small>
                        <a asp-controller="Shop" asp-action="Detail" asp-route-id="@p.Id" class="product-title">@p.Name</a>
                        <strong class="product-price">@p.Price.ToString("N0") đ</strong>
                    </div>
                </article>
            }
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function selectSize(btn) {
            btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
        }
        function changeDetailQty(delta) {
            const el = document.getElementById('detailQty');
            const next = Math.max(1, (parseInt(el.textContent) || 1) + delta);
            el.textContent = next;
        }
        function addDetailToCart(id, name, price, image) {
            const qty = parseInt(document.getElementById('detailQty').textContent) || 1;
            const key = 'fashionhub_cart';
            let cart = JSON.parse(localStorage.getItem(key) || '[]');
            const item = cart.find(x => String(x.id) === String(id));
            if (item) item.quantity = (Number(item.quantity) || 1) + qty;
            else cart.push({ id: String(id), name, price: Number(price), image, quantity: qty });
            localStorage.setItem(key, JSON.stringify(cart));
            localStorage.setItem('cart', JSON.stringify(cart));
            if (typeof updateHeaderCartBadge === 'function') updateHeaderCartBadge();
            alert('Đã thêm ' + qty + ' "' + name + '" vào giỏ hàng!');
        }
    </script>
}