@model ProductViewModel
@{
    Layout = null;
    var related = ViewBag.Related as List<ProductViewModel> ?? new();
    var images = ViewBag.Images as List<string> ?? new List<string> { Model.Image };
    var reviews = ViewBag.Reviews as List<ShopProject.Models.Entities.DanhGium> ?? new();
    var variants = ViewBag.Variants as IEnumerable<dynamic> ?? Array.Empty<dynamic>();
    var avgRating = reviews.Count > 0 ? reviews.Average(r => (double)r.SoSao) : 5.0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@Model.Name - FashionHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
</head>
<body>
    <header class="store-header">
        <a class="store-brand" href="/Shop"><span>F</span> FashionHub</a>
        <form class="store-search" method="get" asp-action="Index" asp-controller="Shop">
            <input name="search" placeholder="Tìm kiếm sản phẩm..." />
            <button type="submit">⌕</button>
        </form>
        <nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="#">@User.Identity.Name</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                {
                    <a href="/">Bảng điều khiển</a>
                }
                <form asp-action="Logout" asp-controller="Shop" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-link">Đăng xuất</button>
                </form>
            }
            else
            {
                <a href="/Shop/Login">Đăng nhập</a>
            }
            <a href="/Shop/Cart" class="cart-link">♡ Giỏ hàng <b>0</b></a>
        </nav>
    </header>

    <main class="detail-page">
        <nav class="breadcrumb">
            <a href="/Shop">Trang chủ</a><span>/</span>
            <a href="/Shop?category=@Uri.EscapeDataString(Model.Category)">@Model.Category</a><span>/</span>
            <strong>@Model.Name</strong>
        </nav>

        <div class="detail-layout">
            <section class="detail-gallery">
                <div class="main-detail-image"><img src="@Model.Image" alt="@Model.Name"></div>
                <div class="detail-thumbs">
                    @foreach (var imgUrl in images)
                    {
                        <img src="@imgUrl" alt="@Model.Name">
                    }
                </div>
            </section>

            <section class="detail-info">
                <span class="hero-tag">@Model.Category</span>
                <h1>@Model.Name</h1>
                <div class="detail-rating">
                    <b>★★★★★</b>
                    <span>@avgRating.ToString("0.0") (@reviews.Count đánh giá)</span>
                </div>
                <strong class="detail-price">@Model.Price.ToString("N0") đ</strong>
                <p class="detail-description">@(ViewBag.Description ?? "Sản phẩm được may từ chất liệu cao cấp, mềm mại và thoáng mát.")</p>

                <div class="option-group">
                    <label>Phân loại (Size / Màu sắc)</label>
                    <div class="size-options">
                        @foreach (var v in variants)
                        {
                            <button type="button" data-variant-id="@v.Id" data-price="@v.Price" @(v.Available <= 0 ? "disabled" : "")>
                                @v.Size - @v.Color (Còn @v.Available)
                            </button>
                        }
                    </div>
                </div>
                <form method="post" asp-action="AddToCart" asp-controller="Shop" id="add-to-cart-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="variantId" id="selected-variant-id" value="" />
                    <input type="hidden" name="quantity" id="selected-quantity" value="1" />

                    <div class="detail-actions">
                        <div class="quantity detail-quantity">
                            <button type="button" id="qty-minus">−</button>
                            <strong id="qty-display">1</strong>
                            <button type="button" id="qty-plus">＋</button>
                        </div>
                        <button type="submit" class="checkout-button">Thêm vào giỏ hàng</button>
                        <button type="button" class="detail-favorite" data-wishlist="@Model.Id">♡</button>
                    </div>
                </form>

               
                <div class="detail-benefits">
                    <span>✓ Giao hàng miễn phí</span>
                    <span>✓ Đổi trả trong 7 ngày</span>
                    <span>✓ Thanh toán khi nhận hàng</span>
                </div>
            </section>
        </div>

        <section class="review-detail">
            <div class="section-heading">
                <div><span>ĐÁNH GIÁ</span><h2>Nhận xét từ khách hàng</h2></div>
                <b>@avgRating.ToString("0.0")/5 (@reviews.Count đánh giá)</b>
            </div>
            @if (reviews.Count == 0)
            {
                <p>Chưa có đánh giá nào cho sản phẩm này.</p>
            }
            else
            {
                @foreach (var dg in reviews)
                {
                    <article class="detail-review">
                        <div>
                            <b>@(dg.NguoiDung?.HoTen ?? "Khách hàng")</b>
                            <small>@dg.ThoiGianTao.ToString("dd/MM/yyyy")</small>
                        </div>
                        <div>
                            <span>@(new string('★', dg.SoSao))</span>
                            <p>@dg.NoiDung</p>
                        </div>
                    </article>
                }
            }
        </section>

        <section class="recommend-section">
            <div class="section-heading">
                <div><span>CÓ THỂ BẠN THÍCH</span><h2>Sản phẩm liên quan</h2></div>
            </div>
            <div class="recommend-grid">
                @foreach (var p in related)
                {
                    <article class="product-card">
                        <a href="/Shop/Detail/@p.Id" class="product-photo"><img src="@p.Image" alt="@p.Name"></a>
                        <div class="product-info">
                            <small>@p.Category</small>
                            <h3><a href="/Shop/Detail/@p.Id">@p.Name</a></h3>
                            <strong>@p.Price.ToString("N0") đ</strong>
                        </div>
                    </article>
                }
            </div>
        </section>
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
     <script>
        document.addEventListener('DOMContentLoaded', function () {
            const variantBtns = document.querySelectorAll('.size-options button[data-variant-id]:not([disabled])');
            const variantInput = document.getElementById('selected-variant-id');
            const priceEl = document.querySelector('.detail-price');
            const qtyInput = document.getElementById('selected-quantity');
            const qtyDisplay = document.getElementById('qty-display');

            function selectVariant(btn) {
                variantBtns.forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                variantInput.value = btn.dataset.variantId;
                if (priceEl && btn.dataset.price) {
                    priceEl.textContent = Number(btn.dataset.price).toLocaleString('vi-VN') + ' đ';
                }
            }

            if (variantBtns.length > 0) selectVariant(variantBtns[0]);
            variantBtns.forEach(btn => btn.addEventListener('click', () => selectVariant(btn)));

            document.getElementById('qty-minus')?.addEventListener('click', () => {
                const next = Math.max(1, Number(qtyInput.value) - 1);
                qtyInput.value = next;
                qtyDisplay.textContent = next;
            });
            document.getElementById('qty-plus')?.addEventListener('click', () => {
                const next = Number(qtyInput.value) + 1;
                qtyInput.value = next;
                qtyDisplay.textContent = next;
            });
        });
    </script>
</body>
</html>