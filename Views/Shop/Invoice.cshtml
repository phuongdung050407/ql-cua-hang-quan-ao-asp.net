@model List<ProductViewModel>
@{ Layout = null; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hóa đơn @ViewBag.OrderCode</title><link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/store.css"></head><body><main class="invoice-page"><article class="invoice"><header><div><span class="invoice-logo">F</span><h1>FashionHub</h1></div><div class="invoice-title"><span>HÓA ĐƠN</span><strong>@ViewBag.OrderCode</strong></div></header><div class="invoice-info"><div><small>KHÁCH HÀNG</small><strong>Nguyễn Văn An</strong><p>0912 345 678<br>123 Đường ABC, Quận 1, TP.HCM</p></div><div><small>THÔNG TIN ĐƠN</small><p>Ngày lập: 19/11/2026<br>Phương thức: COD<br>Trạng thái: Chờ xác nhận</p></div></div><table class="invoice-table"><thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.Name</strong><small>@p.Category</small></td><td>1</td><td>@p.Price.ToString("N0") đ</td><td>@p.Price.ToString("N0") đ</td></tr>}</tbody></table><div class="invoice-total"><div><span>Tạm tính</span><strong>1.130.000 đ</strong></div><div><span>Phí vận chuyển</span><strong>0 đ</strong></div><div><span>Tổng cộng</span><strong>1.130.000 đ</strong></div></div><footer><p>Cảm ơn quý khách đã mua sắm tại FashionHub.</p><button onclick="window.print()" class="checkout-button">In hóa đơn</button></footer></article></main></body></html>