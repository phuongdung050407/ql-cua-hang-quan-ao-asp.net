@model List<ProductViewModel>
@{
    Layout = "_ShopLayout";
    ViewData["Title"] = "Thanh toán";
}

<main class="checkout-page checkout-v2">
    <div class="commerce-back-link">
        <a asp-controller="Shop" asp-action="Cart"><span aria-hidden="true">←</span> Quay lại giỏ hàng</a>
        <span>THANH TOÁN AN TOÀN <b aria-hidden="true">◇</b></span>
    </div>

    <header class="commerce-heading checkout-heading-v2">
        <div>
            <p class="commerce-kicker">FASHIONHUB <span>/</span> CHECKOUT</p>
            <h1>Hoàn tất <em>đơn hàng</em></h1>
            <p class="commerce-intro">Chỉ còn một bước nữa để món đồ yêu thích về với bạn.</p>
        </div>
        <div class="checkout-trust-mark"><span>✓</span><div><strong>Thanh toán an toàn</strong><small>Bảo vệ thông tin của bạn</small></div></div>
    </header>

    <nav class="commerce-progress" aria-label="Tiến trình mua hàng">
        <a class="commerce-step commerce-step-done" asp-controller="Shop" asp-action="Cart"><span>✓</span><strong>Giỏ hàng</strong></a>
        <i></i>
        <div class="commerce-step commerce-step-active" aria-current="step"><span>02</span><strong>Giao hàng</strong></div>
        <i></i>
        <div class="commerce-step"><span>03</span><strong>Hoàn tất</strong></div>
    </nav>

    @if (TempData["CartError"] != null)
    {
        <div class="cart-notice" role="alert">@TempData["CartError"]</div>
    }

    <div class="checkout-layout checkout-layout-v2">
        <form class="checkout-form checkout-form-v2" id="place-order-form" method="post" asp-controller="Shop" asp-action="PlaceOrder">
            @Html.AntiForgeryToken()
            <section class="checkout-section">
                <header class="checkout-section-heading">
                    <span class="checkout-section-number">01</span>
                    <div><h2>Thông tin giao hàng</h2><p>Địa chỉ để chúng tôi giao đơn hàng đến bạn.</p></div>
                </header>
                <div class="form-grid checkout-fields">
                    <label>
                        Họ và tên
                        <input name="fullName" required maxlength="150" value="@User.Identity?.Name" placeholder="Nguyễn Văn An" autocomplete="name" />
                    </label>
                    <label>
                        Số điện thoại
                        <input name="phone" required maxlength="20" type="tel" placeholder="0912 345 678" autocomplete="tel" />
                    </label>
                    <label class="full">
                        Email
                        <input name="email" type="email" required value="@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value" placeholder="email@example.com" autocomplete="email" />
                    </label>
                    <label class="full">
                        Địa chỉ
                        <input name="address" required maxlength="300" placeholder="Số nhà, tên đường, phường / xã" autocomplete="street-address" />
                    </label>
                    <div class="mb-3">
                        <label for="TinhThanh" class="form-label">Tỉnh/Thành phố</label>
                        <select id="TinhThanh" name="TinhThanh" class="form-select">
                            <option value="">-- Chọn tỉnh/thành phố --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="XaPhuong" class="form-label">Xã/Phường</label>
                        <select id="XaPhuong" name="XaPhuong" class="form-select" required disabled>
                            <option value="">-- Chọn xã/phường --</option>
                        </select>
                    </div>
                    <label class="full">
                        Ghi chú <span class="optional-label">Không bắt buộc</span>
                        <textarea name="note" maxlength="500" rows="3" placeholder="Lưu ý khi giao hàng, thời gian nhận hàng..."></textarea>
                    </label>
                </div>
            </section>

            <section class="checkout-section payment-section-v2">
                <header class="checkout-section-heading">
                    <span class="checkout-section-number">02</span>
                    <div><h2>Phương thức thanh toán</h2><p>Chọn cách thanh toán phù hợp với bạn.</p></div>
                </header>
                <label class="payment-option payment-option-v2 selected">
                    <input type="radio" name="payment" value="COD" checked />
                    <span class="payment-option-icon">▣</span>
                    <span class="payment-option-copy"><b>Thanh toán khi nhận hàng</b><small>Thanh toán tiền mặt sau khi kiểm tra sản phẩm</small></span>
                    <span class="payment-radio" aria-hidden="true"></span>
                </label>
                <label class="payment-option payment-option-v2">
                    <input type="radio" name="payment" value="Bank" />
                    <span class="payment-option-icon">⌁</span>
                    <span class="payment-option-copy"><b>Chuyển khoản ngân hàng</b><small>Thông tin chuyển khoản được gửi sau khi đặt hàng</small></span>
                    <span class="payment-radio" aria-hidden="true"></span>
                </label>
            </section>

            <div class="checkout-privacy-note"><span>◇</span><p>Thông tin cá nhân của bạn chỉ được sử dụng để xử lý và giao đơn hàng.</p></div>
        </form>

        <aside class="order-summary checkout-summary-v2">
            <div class="summary-overline"><span>ORDER SUMMARY</span><span class="summary-lock">● SECURE</span></div>
            <h2>Đơn hàng của bạn</h2>
            <div id="checkoutProducts" class="checkout-products-list"></div>
            <div class="checkout-summary-lines">
                <div><span>Tạm tính</span><strong id="checkoutSubtotal">0 đ</strong></div>
                <div><span>Vận chuyển</span><strong class="shipping-free">Miễn phí</strong></div>
                <div><span>Ưu đãi</span><strong id="checkoutDiscount">0 đ</strong></div>
            </div>
            <div class="summary-grand-total checkout-grand-total">
                <span>Tổng thanh toán</span>
                <strong id="checkoutTotal">0 đ</strong>
                <small>Đã bao gồm thuế VAT</small>
            </div>
            <button type="submit" form="place-order-form" class="checkout-button cart-checkout-cta" id="place-order-button">
                <span>Xác nhận đặt hàng</span><b aria-hidden="true">→</b>
            </button>
            <a class="checkout-edit-link" asp-controller="Shop" asp-action="Cart">← Chỉnh sửa giỏ hàng</a>
            <p class="summary-safe-note"><span aria-hidden="true">✓</span> Mã hóa bảo mật thông tin thanh toán</p>
        </aside>
    </div>
</main>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/diachi.js" asp-append-version="true"></script>
}