@model List<ProductViewModel>
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Sản phẩm yêu thích - FashionHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body>
<header class="store-header">
    <a class="store-brand" href="/Shop"><span>F</span> FashionHub</a>
    <form class="store-search" method="get" action="/Shop"><input name="search" placeholder="Tìm kiếm sản phẩm..." /></form>
    <nav>
        <a href="/Shop">Tiếp tục mua sắm</a>
        <a href="/Shop/Wishlist">Yêu thích</a>
        <a href="/Shop/Cart" class="cart-link">Giỏ hàng <b>0</b></a>
    </nav>
</header>
<main class="wishlist-page">
    <div class="page-heading">
        <div><span class="eyebrow">TÀI KHOẢN CỦA TÔI</span><h1>Sản phẩm yêu thích</h1></div>
        <a class="continue-shopping top" href="/Shop">← Tiếp tục mua sắm</a>
    </div>

    @if (Model.Count == 0)
    {
        <section class="empty-cart wishlist-empty">
            <div>♡</div>
            <h2>Chưa có sản phẩm yêu thích</h2>
            <p>Nhấn biểu tượng trái tim để lưu sản phẩm bạn quan tâm.</p>
            <a class="checkout-button" href="/Shop">Khám phá sản phẩm</a>
        </section>
    }
    else
    {
        <div class="recommend-grid wishlist-grid">
        @foreach (var p in Model)
        {
            <article class="product-card wishlist-item" data-wishlist-item="@p.Id">
                <a href="/Shop/Detail/@p.Id" class="product-photo">
                    <img src="@p.Image" alt="@p.Name" />
                    <span class="recommend-label">Yêu thích</span>
                </a>
                <button type="button" class="favorite-button active" data-wishlist="@p.Id" aria-label="Bỏ yêu thích">♥</button>
                <div class="product-info">
                    <small>@p.Category</small>
                    <h3><a href="/Shop/Detail/@p.Id">@p.Name</a></h3>
                    <div>
                        <strong>@p.Price.ToString("N0") đ</strong>
                        <button type="button" class="add-button" data-add-cart="@p.Id" data-name="@p.Name" data-price="@((int)p.Price)" data-image="@p.Image" data-category="@p.Category" aria-label="Thêm vào giỏ hàng">＋</button>
                    </div>
                </div>
            </article>
        }
        </div>
    }
</main>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
