@model List<ProductViewModel>
@{
    Layout = "_ShopLayout";
    ViewData["Title"] = "Đặt hàng thành công";
    var order = ViewBag.Order as ShopProject.Models.DonHang;
    var tongTien = order?.TongThanhToan ?? Model.Sum(x => x.Price);
}

<main class="success-page">
    <section class="success-card">
        <div class="success-icon">✓</div>
        <span class="hero-tag">ĐẶT HÀNG THÀNH CÔNG</span>
        <h1>Cảm ơn bạn đã mua hàng</h1>
        <p>Đơn hàng <strong>@ViewBag.OrderCode</strong> đã được xác nhận. Chúng tôi sẽ liên hệ để xác nhận trước khi giao hàng.</p>
        <div class="success-order">
            <div><span>Mã đơn hàng</span><strong>@ViewBag.OrderCode</strong></div>
            <div><span>Trạng thái</span><strong>Chờ xác nhận</strong></div>
            <div><span>Tổng thanh toán</span><strong>@tongTien.ToString("N0") đ</strong></div>
        </div>
        <div class="success-actions">
            <a asp-controller="Shop" asp-action="Invoice" asp-route-id="@ViewBag.OrderCode" class="checkout-button">Xem hóa đơn</a>
            <a asp-controller="Shop" asp-action="MyOrders" class="secondary-store-button">Lịch sử mua hàng</a>
            <a asp-controller="Shop" asp-action="Index" class="secondary-store-button">Về trang chủ</a>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        localStorage.removeItem('fashionhub_cart');
        localStorage.removeItem('fashionhub-cart');
        localStorage.removeItem('cart');
        sessionStorage.removeItem('fashionhub-coupon');
        if (typeof updateHeaderCartBadge === 'function') updateHeaderCartBadge();
    </script>
}