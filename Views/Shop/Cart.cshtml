@model List<CartItemViewModel>
@{
    Layout = null;
    var tongTien = Model.Sum(x => x.SubTotal);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Giỏ hàng - FashionHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
</head>
<body>
    <header class="store-header">
        <a class="store-brand" href="/Shop"><span>F</span> FashionHub</a>
        <form class="store-search" method="get" asp-action="Index" asp-controller="Shop">
            <input name="search" placeholder="Tìm kiếm sản phẩm...">
        </form>
        <nav>
            <a href="/Shop">@(User.Identity?.Name ?? "Tài khoản")</a>
            <a class="cart-link">Giỏ hàng <b>@Model.Sum(x => x.Quantity)</b></a>
        </nav>
    </header>

    <main class="cart-page">
        <div class="page-heading">
            <div><span class="eyebrow">ĐƠN HÀNG CỦA BẠN</span><h1>Giỏ hàng</h1></div>
        </div>

        @if (TempData["CartError"] != null)
        {
            <p style="color:#b91c1c;margin-bottom:16px">@TempData["CartError"]</p>
        }

        @if (Model.Count == 0)
        {
            <div style="text-align:center;padding:48px 0">
                <p>Giỏ hàng của bạn đang trống.</p>
                <a class="checkout-button" style="display:inline-block;margin-top:12px" href="/Shop">← Tiếp tục mua sắm</a>
            </div>
        }
        else
        {
            <div class="cart-layout">
                <section class="cart-items">
                    @foreach (var p in Model)
                    {
                        <article class="cart-item">
                            <img src="@p.Image" alt="@p.Name">
                            <div class="cart-item-info">
                                <small>@p.Category</small>
                                <h3><a href="/Shop/Detail/@p.ProductId">@p.Name</a></h3>
                                <span>Kích thước: @p.Size &nbsp; Màu: @p.Color</span>
                            </div>

                            <div class="quantity">
                                <form method="post" asp-action="UpdateCart" asp-controller="Shop" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@p.CartItemId" />
                                    <input type="hidden" name="delta" value="-1" />
                                    <button type="submit">−</button>
                                </form>
                                <strong>@p.Quantity</strong>
                                <form method="post" asp-action="UpdateCart" asp-controller="Shop" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@p.CartItemId" />
                                    <input type="hidden" name="delta" value="1" />
                                    <button type="submit">＋</button>
                                </form>
                            </div>

                            <strong>@p.SubTotal.ToString("N0") đ</strong>

                            <form method="post" asp-action="RemoveCart" asp-controller="Shop" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@p.CartItemId" />
                                <button type="submit" class="remove">×</button>
                            </form>
                        </article>
                    }
                </section>

                <aside class="order-summary">
                    <h2>Tóm tắt đơn hàng</h2>
                    <div><span>Tạm tính</span><strong>@tongTien.ToString("N0") đ</strong></div>
                    <div><span>Phí vận chuyển</span><strong>Miễn phí</strong></div>
                    <div class="total"><span>Tổng cộng</span><strong>@tongTien.ToString("N0") đ</strong></div>
                    <a class="checkout-button" href="/Shop/Checkout">Tiến hành thanh toán</a>
                    <a class="continue-shopping" href="/Shop">← Tiếp tục mua sắm</a>
                </aside>
            </div>
        }
    </main>
</body>
</html>