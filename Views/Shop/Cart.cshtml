@model List<ProductViewModel>
@{ Layout = null; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Giỏ hàng - FashionHub</title><link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/store.css" /></head><body>
<header class="store-header"><a class="store-brand" href="/Shop"><span>F</span> FashionHub</a><form class="store-search"><input placeholder="Tìm kiếm sản phẩm..."></form><nav><a href="/Shop/Login">Đăng nhập</a><a class="cart-link">Giỏ hàng <b>@Model.Count</b></a></nav></header>
<main class="cart-page"><div class="page-heading"><div><span class="eyebrow">ĐƠN HÀNG CỦA BẠN</span><h1>Giỏ hàng</h1></div></div><div class="cart-layout"><section class="cart-items">
@foreach (var p in Model){<article class="cart-item" data-price="@((int)p.Price)"><img src="@p.Image"><div class="cart-item-info"><small>@p.Category</small><h3>@p.Name</h3><span>Kích thước: M &nbsp; Màu: Trắng</span></div><div class="quantity"><button type="button">−</button><strong>1</strong><button type="button">＋</button></div><strong>@p.Price.ToString("N0") đ</strong><button type="button" class="remove">×</button></article>}
</section><aside class="order-summary"><h2>Tóm tắt đơn hàng</h2><div><span>Tạm tính</span><strong>1.130.000 đ</strong></div><div><span>Phí vận chuyển</span><strong>Miễn phí</strong></div><div class="coupon"><input placeholder="Mã khuyến mãi"><button>Áp dụng</button></div><div class="total"><span>Tổng cộng</span><strong>1.130.000 đ</strong></div><a class="checkout-button" href="/Shop/Checkout">Tiến hành thanh toán</a><a class="continue-shopping" href="/Shop">← Tiếp tục mua sắm</a></aside></div></main><script src="~/js/site.js" asp-append-version="true"></script>
</body></html>