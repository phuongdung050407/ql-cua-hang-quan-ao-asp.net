@model List<ProductViewModel>
@{
    Layout = "_ShopLayout";
    ViewData["Title"] = "Giỏ hàng";
}

<main class="cart-page cart-v2 cart-v3">
    <div class="commerce-back-link">
        <a asp-controller="Shop" asp-action="Index"><span aria-hidden="true">←</span> Tiếp tục mua sắm</a>
        <span class="cart-topline-tag"><i></i> ĐỔI TRẢ 7 NGÀY / FREESHIP TỪ 500K</span>
    </div>

    <header class="commerce-heading">
        <div>
            <p class="commerce-kicker">FASHIONHUB <span>/</span> YOUR PICKS</p>
            <h1>Túi đồ <em>có gu.</em></h1>
            <p class="commerce-intro">Bạn chọn món nào, câu chuyện phong cách bắt đầu từ đó.</p>
        </div>
        <div class="commerce-heading-mark" aria-hidden="true">
            <span>01</span>
            <small>YOUR<br />STYLE<br />FILE</small>
        </div>
    </header>

    <nav class="commerce-progress" aria-label="Tiến trình mua hàng">
        <div class="commerce-step commerce-step-active"><span>01</span><strong>Giỏ hàng</strong></div>
        <i></i>
        <div class="commerce-step"><span>02</span><strong>Giao hàng</strong></div>
        <i></i>
        <div class="commerce-step"><span>03</span><strong>Hoàn tất</strong></div>
    </nav>

    @if (TempData["CartError"] != null)
    {
        <div class="cart-notice" role="alert">@TempData["CartError"]</div>
    }

    <div class="cart-layout cart-layout-v2">
        <section class="cart-main-column">
            <div class="cart-products-panel">
                <header class="cart-panel-heading">
                    <div>
                        <span class="commerce-kicker">PICKED BY YOU / READY TO WEAR</span>
                        <h2>Sản phẩm <span id="cartItemCount">0</span></h2>
                    </div>
                    <span class="cart-panel-note">Đã gồm thuế <b>·</b> Đổi trả 7 ngày</span>
                </header>
                <div class="cart-items" id="cartItemsContainer"></div>
                <footer class="cart-assurance">
                    <div><span class="assurance-icon">↗</span><span><strong>Giao hàng toàn quốc</strong><small>Đóng gói cẩn thận, theo dõi dễ dàng</small></span></div>
                    <div><span class="assurance-icon">↺</span><span><strong>Đổi trả trong 7 ngày</strong><small>An tâm chọn đúng phong cách</small></span></div>
                </footer>
            </div>
        </section>

        <aside class="order-summary cart-summary-v2">
            <div class="summary-overline"><span>YOUR ORDER</span><span class="summary-lock">● BẢO MẬT</span></div>
            <h2>Tóm tắt đơn hàng</h2>
            <div class="summary-items-count"><span id="summaryItemCount">0 sản phẩm</span><span>VND</span></div>
            <div class="summary-calculation">
                <div><span>Tạm tính</span><strong id="cartSubtotal">0 đ</strong></div>
                <div><span>Vận chuyển</span><strong class="shipping-free">Miễn phí</strong></div>
            </div>

            <div class="coupon coupon-v2">
                <label for="cartCoupon">Mã ưu đãi</label>
                <div class="coupon-control">
                    <span aria-hidden="true">％</span>
                    <input id="cartCoupon" placeholder="Nhập mã giảm giá" autocomplete="off" />
                    <button type="button">Áp dụng</button>
                </div>
                <p class="coupon-message" aria-live="polite"></p>
            </div>

            <div class="summary-grand-total">
                <span>Tổng thanh toán</span>
                <strong id="cartTotal">0 đ</strong>
                <small>Đã bao gồm thuế VAT</small>
            </div>

            <a class="checkout-button cart-checkout-cta" asp-controller="Shop" asp-action="Checkout">
                <span>Tiến hành thanh toán</span><b aria-hidden="true">→</b>
            </a>
            <p class="summary-safe-note"><span aria-hidden="true">✓</span> Thông tin của bạn được bảo mật an toàn</p>
        </aside>
    </div>
</main>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
