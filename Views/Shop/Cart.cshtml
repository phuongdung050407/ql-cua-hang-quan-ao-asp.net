@model List<ProductViewModel>
@{
    Layout = "_ShopLayout";
    ViewData["Title"] = "Giỏ hàng";
}

<main class="cart-page">
    <div class="page-heading">
        <div><span class="eyebrow">ĐƠN HÀNG CỦA BẠN</span><h1>Giỏ hàng</h1></div>
    </div>

    <div class="cart-layout">
        <section class="cart-items" id="cartItemsContainer">
            @foreach (var p in Model)
            {
                <article class="cart-item" data-price="@((int)p.Price)">
                    <img src="@p.Image" alt="@p.Name" />
                    <div class="cart-item-info">
                        <small>@p.Category</small>
                        <h3>@p.Name</h3>
                        <span>Kích thước: M &nbsp; Màu: Trắng</span>
                    </div>
                    <div class="quantity"><button type="button">−</button><strong>1</strong><button type="button">＋</button></div>
                    <strong>@p.Price.ToString("N0") đ</strong>
                    <button type="button" class="remove">×</button>
                </article>
            }
        </section>

        <aside class="order-summary">
            <h2>Tóm tắt đơn hàng</h2>
            <div><span>Tạm tính</span><strong id="cartSubtotal">@Model.Sum(x => x.Price).ToString("N0") đ</strong></div>
            <div><span>Phí vận chuyển</span><strong>Miễn phí</strong></div>
            <div class="coupon"><input placeholder="Mã khuyến mãi (VD: NEWYEAR20)" /><button type="button">Áp dụng</button></div>
            <div class="total"><span>Tổng cộng</span><strong id="cartTotal">@Model.Sum(x => x.Price).ToString("N0") đ</strong></div>
            <a class="checkout-button" asp-controller="Shop" asp-action="Checkout">Tiến hành thanh toán</a>
            <a class="continue-shopping" asp-controller="Shop" asp-action="Index">← Tiếp tục mua sắm</a>
        </aside>
    </div>
</main>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}