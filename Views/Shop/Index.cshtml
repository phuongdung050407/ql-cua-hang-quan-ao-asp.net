@model StoreViewModel
@{ Layout = null; ViewData["Title"] = "FashionHub - Trang chủ"; }
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>@ViewData["Title"]</title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
</head>
<body>
<header class="store-header"><a class="store-brand" href="/Shop"><span>F</span> FashionHub</a><form class="store-search" method="get" asp-action="Index" asp-controller="Shop"><input name="search" placeholder="Tìm kiếm sản phẩm..." /><button type="submit">⌕</button></form><nav>
@if (User.Identity?.IsAuthenticated == true)
{
    <a href="#">@User.Identity.Name</a>
    @if (User.IsInRole("Admin") || User.IsInRole("Employee")) { <a href="/">Bảng điều khiển</a> }
    <form asp-action="Logout" asp-controller="Shop" method="post" style="display:inline">@Html.AntiForgeryToken()<button type="submit" class="logout-link">Đăng xuất</button></form>
}
else
{
    <a href="/Shop/Login">Đăng nhập</a>
}
<a href="/Shop/Cart" class="cart-link">♡ Giỏ hàng <b>2</b></a></nav></header>
<nav class="category-nav">
    <a href="/Shop">Tất cả</a>
    @foreach (var c in Model.Categories)
    {
        <a href="/Shop?category=@Uri.EscapeDataString(c.Name)">@c.Name</a>
    }
</nav>
<main>
<section class="hero"><div><span class="hero-tag">BỘ SƯU TẬP MỚI</span><h1>Phong cách<br/>dành cho bạn</h1><p>Thời trang hiện đại, chất liệu mềm mại và tự tin trong từng khoảnh khắc.</p><a href="#products">Khám phá ngay <b>→</b></a></div><img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=900" alt="Bộ sưu tập thời trang"></section>
<section id="products" class="store-section"><div class="section-heading"><div><span>SẢN PHẨM</span><h2>Sản phẩm nổi bật</h2></div><a href="/Shop">Xem tất cả →</a></div>
<div class="product-grid">
    @foreach (var p in Model.Products)
    {
        <article class="product-card">
            <a href="/Shop/Detail/@p.Id" class="product-photo">
            <img src="@p.Image" alt="@p.Name">
            <span>New</span>
            </a>
            <button type="button" class="favorite-button" data-wishlist="@p.Id">♡</button>
            <div class="product-info"><small>@p.Category</small>
            <h3><a href="/Shop/Detail/@p.Id">@p.Name</a></h3>
            <div><strong>@p.Price.ToString("N0") đ</strong>
            <button type="button" class="add-button" data-add-cart="@p.Id" data-name="@p.Name" data-price="@((int)p.Price)" data-image="@p.Image" data-category="@p.Category">＋</button></div></div></article>}</div></section>
<section class="recommend-section"><div class="section-heading"><div><span>DÀNH RIÊNG CHO BẠN</span><h2>Gợi ý cho bạn</h2></div></div><div class="recommend-grid">
    @foreach (var p in Model.RecommendedProducts)
    {
        <article class="product-card">
            <a href="/Shop/Detail/@p.Id" class="product-photo"><img src="@p.Image" alt="@p.Name"></a>
            <div class="product-info">
                <small>@p.Category</small>
                <h3><a href="/Shop/Detail/@p.Id">@p.Name</a></h3>
                <strong>@p.Price.ToString("N0") đ</strong>
            </div>
        </article>
    }
</div>
</section>
</main><script src="~/js/site.js" asp-append-version="true"></script>
<footer class="store-footer"><div><h3>FashionHub</h3><p>Phong cách của bạn, thế giới của chúng tôi.</p></div><div><h4>Hỗ trợ</h4><a>Liên hệ</a><a>Chính sách đổi trả</a><a>Câu hỏi thường gặp</a></div><div><h4>Liên hệ</h4><p>hello@fashionhub.vn</p><p>0123 456 789</p></div></footer>
</body></html>