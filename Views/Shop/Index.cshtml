@model StoreViewModel
@{
    Layout = "_ShopLayout";
    ViewData["Title"] = "Trang chủ cửa hàng";
    var currentCategory = Context.Request.Query["category"].ToString();
    var currentSearch = Context.Request.Query["search"].ToString();
}

<!-- 1. HERO BANNER -->
<section class="hero-section">
    <div class="container">
        <div class="hero-card">
            <div class="hero-content">
                <span class="hero-eyebrow">NEW COLLECTION 2026</span>
                <h1>Phong Cách Tối Giản,<br />Chất Liệu Tinh Tế.</h1>
                <p>Khám phá những thiết kế mới nhất với phom dáng chuẩn mực, dễ phối đồ từ công sở đến dạo phố cuối tuần.</p>
                <div class="hero-cta">
                    <a href="#san-pham-noi-bat" class="btn-dark-solid">Mua sắm ngay →</a>
                    <a asp-controller="Shop" asp-action="Index" class="btn-outline-light-custom">Xem tất cả (@Model.Products.Count)</a>
                </div>
            </div>
            <div class="hero-visual">
                <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=900" alt="FashionHub Collection" />
                <div class="hero-floating-tag">
                    <strong>Giảm 150.000đ</strong>
                    <span>Mã: NEWYEAR20</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. CAM KẾT DỊCH VỤ -->
<section class="service-strip">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="service-item">
                    <span class="srv-icon">🚚</span>
                    <div>
                        <strong>Miễn phí vận chuyển</strong>
                        <small>Cho đơn hàng từ 500.000đ</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="service-item">
                    <span class="srv-icon">↺</span>
                    <div>
                        <strong>Đổi trả trong 7 ngày</strong>
                        <small>Hỗ trợ đổi size tận nơi</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="service-item">
                    <span class="srv-icon">🛡</span>
                    <div>
                        <strong>Thanh toán linh hoạt</strong>
                        <small>Kiểm tra hàng trước khi trả</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="service-item">
                    <span class="srv-icon">✦</span>
                    <div>
                        <strong>Chất liệu cao cấp</strong>
                        <small>Kiểm định đường may tỉ mỉ</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3. GỢI Ý SẢN PHẨM -->
@if (Model.Recommendations.Any())
{
    <section id="goi-y-cho-ban" class="home-recommendations container">
        <div class="section-header">
            <div>
                <span class="sec-sub">@(User.Identity?.IsAuthenticated == true ? "DỰA TRÊN LỰA CHỌN CỦA BẠN" : "FASHIONHUB TUYỂN CHỌN")</span>
                <h2>Gợi ý sản phẩm</h2>
            </div>
            <a asp-controller="Shop" asp-action="Recommendations" class="recommendations-more-link">Xem tất cả <span aria-hidden="true">→</span></a>
        </div>
        <div class="row g-4">
            @foreach (var item in Model.Recommendations)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <article class="product-card">
                        <div class="product-thumb">
                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@item.Id">
                                <img src="@item.Image" alt="@item.Name" loading="lazy" />
                            </a>
                            <span class="product-tag">@item.Category</span>
                            <div class="product-overlay">
                                <a asp-controller="Shop" asp-action="Detail" asp-route-id="@item.Id" class="btn-quick-view">Xem chi tiết</a>
                                <button type="button" class="btn-quick-add" data-add-cart="@item.Id" data-variant-id="@item.VariantId"
                                        data-variant-label="@item.VariantLabel" data-stock="@item.Stock" data-name="@item.Name" data-price="@item.Price"
                                        data-image="@item.Image" data-category="@item.Category" disabled="@(item.VariantId == null || item.Stock < 1)">
                                    @(item.Stock > 0 ? "+ Thêm giỏ" : "Tạm hết hàng")
                                </button>
                            </div>
                        </div>
                        <div class="product-info">
                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@item.Id" class="product-title" title="@item.Name">@item.Name</a>
                            <div class="product-bottom">
                                <strong class="product-price">@item.Price.ToString("N0") đ</strong>
                                <span class="product-stock">@item.Status</span>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>
}

<!-- 4. DANH MỤC NỔI BẬT -->
<section class="category-section container">
    <div class="section-header">
        <div>
            <span class="sec-sub">KHÁM PHÁ THEO NHU CẦU</span>
            <h2>Danh mục sản phẩm</h2>
        </div>
        @if (!string.IsNullOrEmpty(currentCategory) || !string.IsNullOrEmpty(currentSearch))
        {
            <a asp-controller="Shop" asp-action="Index" class="clear-filter-link">✕ Xóa bộ lọc hiện tại</a>
        }
    </div>

    <div class="category-pills">
        <a asp-controller="Shop" asp-action="Index"
           class="cat-pill @(string.IsNullOrEmpty(currentCategory) ? "active" : "")">
            <span>Tất cả sản phẩm</span>
            <em>@Model.Categories.Sum(c => c.ProductCount)</em>
        </a>

        @foreach (var cat in Model.Categories)
        {
            var isActive = string.Equals(currentCategory, cat.Name, StringComparison.OrdinalIgnoreCase);
            <a asp-controller="Shop" asp-action="Index" asp-route-category="@cat.Name"
               class="cat-pill @(isActive ? "active" : "")">
                <span>@cat.Name</span>
                <em>@cat.ProductCount</em>
            </a>
        }
    </div>
</section>

<!-- 5. LƯỚI SẢN PHẨM -->
<section id="san-pham-noi-bat" class="products-section container">
    <div class="section-header">
        <div>
            <span class="sec-sub">BỘ SƯU TẬP CỬA HÀNG</span>
            <h2>
                @if (!string.IsNullOrEmpty(currentCategory))
                {
                    @:Danh mục: @currentCategory
                }
                else if (!string.IsNullOrEmpty(currentSearch))
                {
                    @:Kết quả tìm kiếm cho "@currentSearch"
                }
                else
                {
                    @:Sản phẩm nổi bật
                }
            </h2>
        </div>
        <span class="result-count">Hiển thị <strong>@Model.Products.Count</strong> sản phẩm</span>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="empty-box">
            <h4>Không tìm thấy sản phẩm phù hợp</h4>
            <p>Thử tìm kiếm với từ khóa khác hoặc quay lại danh sách tất cả sản phẩm.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn-dark-solid">Xem toàn bộ cửa hàng</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Products)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <article class="product-card">
                        <div class="product-thumb">
                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@item.Id">
                                <img src="@item.Image" alt="@item.Name" loading="lazy" />
                            </a>
                            <span class="product-tag">@item.Category</span>
                            <div class="product-overlay">
                                <a asp-controller="Shop" asp-action="Detail" asp-route-id="@item.Id" class="btn-quick-view">Xem chi tiết</a>
                                <button type="button" class="btn-quick-add" data-add-cart="@item.Id" data-variant-id="@item.VariantId"
                                        data-variant-label="@item.VariantLabel" data-stock="@item.Stock" data-name="@item.Name" data-price="@item.Price"
                                        data-image="@item.Image" data-category="@item.Category" disabled="@(item.VariantId == null || item.Stock < 1)">
                                    @(item.Stock > 0 ? "+ Thêm giỏ" : "Tạm hết hàng")
                                </button>
                            </div>
                        </div>
                        <div class="product-info">
                            <a asp-controller="Shop" asp-action="Detail" asp-route-id="@item.Id" class="product-title" title="@item.Name">
                                @item.Name
                            </a>
                            <div class="product-bottom">
                                <strong class="product-price">@item.Price.ToString("N0") đ</strong>
                                <span class="product-stock">@item.Status</span>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

<!-- 6. BANNER LOOKBOOK / ƯU ĐÃI GIỮA TRANG -->
<section class="promo-banner-section container">
    <div class="promo-box">
        <div>
            <span class="promo-badge">ƯU ĐÃI THÀNH VIÊN</span>
            <h3>Tạo tài khoản để nhận gợi ý phối đồ hợp gu và ưu đãi riêng</h3>
            <p>Giỏ hàng được đồng bộ theo tài khoản để bạn dễ dàng tiếp tục mua sắm khi quay lại.</p>
        </div>
        <div class="promo-actions">
            <a asp-controller="Shop" asp-action="Register" class="btn-light-solid">Tạo tài khoản miễn phí</a>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}