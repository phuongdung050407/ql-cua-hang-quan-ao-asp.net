@model LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Đăng nhập - FashionHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body class="auth-body">
<main class="auth-layout">
    <section class="auth-image login-image">
        <a class="store-brand" href="/Shop"><span>F</span> FashionHub</a>
        <div><h1>Chào mừng<br/>trở lại</h1><p>Tiếp tục trải nghiệm mua sắm của bạn.</p></div>
    </section>
    <section class="auth-form">
        <form method="post" asp-action="Login" asp-controller="Shop">
            @Html.AntiForgeryToken()
            <h1>Đăng nhập</h1>
            <p>Chưa có tài khoản? <a href="/Shop/Register">Tạo tài khoản</a></p>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (TempData["RegisterSuccess"] != null)
            {
                <div class="auth-success">@TempData["RegisterSuccess"]</div>
            }
            <label>Email
                <input asp-for="Email" type="email" required placeholder="email@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </label>
            <label>Mật khẩu
                <input asp-for="Password" type="password" required placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </label>
            <div class="auth-options"><label><input asp-for="RememberMe" type="checkbox" /> Ghi nhớ tôi</label><a href="#">Quên mật khẩu?</a></div>
            <button type="submit" class="checkout-button">Đăng nhập</button>
            <div class="demo-logins">
                <small>Tài khoản kiểm tra</small>
                <span><strong>Admin:</strong> admin@fashion.vn / Admin123&#64;</span>
                <span><strong>Nhân viên:</strong> nhanvien@fashion.vn / Nhanvien123&#64;</span>
                <span><strong>Khách hàng:</strong> khachhang@gmail.com / Khachhang123&#64;</span>
            </div>
        </form>
    </section>
</main>
</body>
</html>