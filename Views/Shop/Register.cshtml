@model RegisterViewModel
@{
    Layout = "_ShopLayout";
    ViewData["Title"] = "Đăng ký tài khoản";
}

<main class="auth-layout auth-register auth-register-v2">
    <section class="auth-image">
        <div class="register-brand-row">
            <div class="brand-text">FASHION<strong>HUB</strong></div>
            <span class="register-brand-index">MEMBER CLUB / 01</span>
        </div>
        <div class="register-graphic" aria-hidden="true">
            <span>F</span>
            <small>FH<br />2026</small>
        </div>
        <div class="auth-image-copy">
            <span class="auth-kicker">FASHIONHUB MEMBERS</span>
            <h1>Mặc theo<br />cách <em>của bạn.</em></h1>
            <p>Gu riêng. Lựa chọn riêng. Những ưu đãi chỉ dành cho bạn.</p>
            <div class="auth-perks">
                <span><b>01</b> Tìm đúng phong cách bạn yêu thích</span>
                <span><b>02</b> Thêm vào giỏ, để đó khi bạn cần</span>
                <span><b>03</b> Săn ưu đãi xịn dành riêng cho bạn</span>
            </div>
    
        </div>
        <div class="register-image-footer"><span>STYLE IS PERSONAL</span><span>EST. 2026</span></div>
    </section>

    <section class="auth-form">
        <form method="post" asp-action="Register" asp-controller="Shop">
            @Html.AntiForgeryToken()
            <div class="register-form-meta">
                <span>CREATE ACCOUNT <b>01—02</b></span>
                <span class="register-form-dot"></span>
            </div>
            <span class="auth-form-eyebrow">BẮT ĐẦU HÀNH TRÌNH MỚI</span>
            <h1>Tạo tài khoản<span>.</span></h1>
            <p class="text-muted mb-3">Một tài khoản. Nhiều lựa chọn mang dấu ấn riêng.</p>
            <p class="auth-existing">Đã có tài khoản? <a asp-controller="Shop" asp-action="Login">Đăng nhập</a></p>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <label>
                Họ và tên
                <input asp-for="FullName" required placeholder="Nguyễn Văn An" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </label>
            <label>
                Email
                <input asp-for="Email" type="email" required placeholder="email@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </label>
            <label>
                Số điện thoại
                <input asp-for="Phone" required placeholder="0912 345 678" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </label>
            <label>
                Mật khẩu
                <div class="password-field">
                    <input asp-for="Password" type="password" required placeholder="Ít nhất 8 ký tự" />
                    <button type="button" class="toggle-password" aria-label="Hiện mật khẩu"
                            onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';this.textContent=i.type==='password'?'👁':'◉'">
                        👁
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </label>
            <label>
                Xác nhận mật khẩu
                <div class="password-field">
                    <input asp-for="ConfirmPassword" type="password" required placeholder="Nhập lại mật khẩu" />
                    <button type="button" class="toggle-password" aria-label="Hiện mật khẩu"
                            onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';this.textContent=i.type==='password'?'👁':'◉'">
                        👁
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </label>

            <button type="submit" class="checkout-button register-submit">
                <span>Tạo tài khoản</span><b aria-hidden="true">↗</b>
            </button>
            <p class="register-legal">Tạo tài khoản đồng nghĩa bạn đồng ý với điều khoản thành viên FashionHub.</p>
        </form>
    </section>
</main>