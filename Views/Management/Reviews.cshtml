@{ ViewData["Title"]="Đánh giá"; }
<div class="page-heading"><div><p class="eyebrow">PHẢN HỒI</p><h1>Đánh giá sản phẩm</h1></div></div>
<div class="stats-grid people-stats"><article class="stat-card"><div class="stat-icon violet">★</div><div><p>Điểm trung bình</p><strong>4.8/5</strong></div></article><article class="stat-card"><div class="stat-icon blue">▤</div><div><p>Tổng đánh giá</p><strong>246</strong></div></article><article class="stat-card"><div class="stat-icon amber">◷</div><div><p>Chờ duyệt</p><strong>8</strong></div></article><article class="stat-card"><div class="stat-icon green">✓</div><div><p>Tỷ lệ hài lòng</p><strong>96%</strong></div></article></div>
<section class="panel review-panel">@foreach(var review in ShopProject.Models.ShopDataStore.Reviews){<article class="review-row"><div class="review-user"><div>@review.Customer.Substring(0,1)</div><span><strong>@review.Customer</strong><small>@review.Date</small></span></div><div class="review-content"><strong>@review.Product</strong><div class="stars">★★★★★</div><p>@review.Comment</p></div><span class="badge @(review.Status=="Đã duyệt"?"badge-success":"badge-warning")">@review.Status</span><select class="action-select review-action" data-review-id="@review.Id"><option value="">Thao tác</option><option value="approve">Duyệt</option><option value="reply">Trả lời</option><option value="hide">Ẩn đánh giá</option></select></article>}</section>