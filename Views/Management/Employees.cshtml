@{ ViewData["Title"]="Nhân viên"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Nhân viên</h1></div><button class="primary-button">＋ Thêm nhân viên</button></div>
<div class="stats-grid people-stats"><article class="stat-card"><div class="stat-icon violet">♧</div><div><p>Tổng nhân viên</p><strong>18</strong></div></article><article class="stat-card"><div class="stat-icon green">✓</div><div><p>Đang làm việc</p><strong>15</strong></div></article><article class="stat-card"><div class="stat-icon amber">◷</div><div><p>Nghỉ phép</p><strong>2</strong></div></article><article class="stat-card"><div class="stat-icon blue">◆</div><div><p>Quản lý</p><strong>3</strong></div></article></div>
<section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Nhân viên</th><th>Chức vụ</th><th>Điện thoại</th><th>Email</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var e in new[]{("Trần Minh","Quản trị viên","0912 345 678","minh@fashion.vn","Hoạt động"),("Nguyễn Lan","Nhân viên bán hàng","0988 111 222","lan@fashion.vn","Hoạt động"),("Lê Tuấn","Kế toán","0977 333 444","tuan@fashion.vn","Nghỉ phép"),("Phạm Hoa","Quản kho","0966 555 777","hoa@fashion.vn","Hoạt động")}){<tr><td><div class="person-cell"><div>@e.Item1.Substring(0,1)</div><strong>@e.Item1</strong></div></td><td>@e.Item2</td><td>@e.Item3</td><td>@e.Item4</td><td><select class="status-select" data-current="@e.Item5"><option>Hoạt động</option><option>Nghỉ phép</option><option>Tạm khóa</option></select></td><td><button type="button" class="icon-button status-save">Lưu</button></td></tr>}</tbody></table></div></section>