@model List<ShopProject.Models.PersonViewModel>
@{ ViewData["Title"]="Nhân viên"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Nhân viên</h1></div><button class="primary-button" data-bs-toggle="modal" data-bs-target="#employeeModal">＋ Thêm nhân viên</button></div>
<div class="stats-grid people-stats"><article class="stat-card"><div class="stat-icon violet">♧</div><div><p>Tổng nhân viên</p><strong>@Model.Count</strong></div></article><article class="stat-card"><div class="stat-icon green">✓</div><div><p>Đang làm việc</p><strong>@Model.Count(p=>p.Status=="Hoạt động")</strong></div></article><article class="stat-card"><div class="stat-icon amber">◷</div><div><p>Nghỉ phép</p><strong>@Model.Count(p=>p.Status=="Nghỉ phép")</strong></div></article><article class="stat-card"><div class="stat-icon blue">◆</div><div><p>Quản lý</p><strong>@Model.Count(p=>p.Role.Contains("Quản"))</strong></div></article></div>
<section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Nhân viên</th><th>Chức vụ</th><th>Điện thoại</th><th>Email</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var person in Model){<tr><td><div class="person-cell"><div>@person.Name.Substring(0,1)</div><strong>@person.Name</strong></div></td><td>@person.Role</td><td>@person.Phone</td><td>@person.Email</td><td><select name="status" class="status-select" data-type="employee" data-id="@person.Id" data-current="@person.Status"><option>Hoạt động</option><option>Nghỉ phép</option><option>Tạm khóa</option></select></td><td><button type="button" class="icon-button status-save" data-type="employee" data-id="@person.Id">Lưu</button></td></tr>}
</tbody></table></div></section>
<div class="modal fade" id="employeeModal"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>Thêm nhân viên</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Nhân viên mới cần được tạo trong module quản lý người dùng sau khi kết nối SQL Server.</p></div></div></div></div>