@using System.Text.Json
@using ShopProject.Controllers
@using ShopProject.Models.Entities
@model List<ShopProject.Models.ProductViewModel>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var categories = ViewBag.Categories as List<DanhMuc> ?? new();
    var categorySizeTypeMap = ViewBag.CategorySizeTypeMap as Dictionary<int, string> ?? new();
    var sizes = ViewBag.Sizes as List<KichThuoc> ?? new();
    var sizeGroupMap = ViewBag.SizeGroupMap as Dictionary<int, string> ?? new();
    var colors = ViewBag.Colors as List<MauSac> ?? new();
    var variantMap = ViewBag.ProductVariants as Dictionary<int, List<ProductVariantInfo>> ?? new();
    var pricingAdvices = ViewBag.PricingAdvices as Dictionary<int, ProductTrendAdvice> ?? new();
    var productMeta = ViewBag.ProductMeta;
    int? selectedCat = ViewBag.SelectedCategory;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "";
    int? openVariantProductId = TempData["OpenVariantProductId"] as int?;

    var variantsJson = JsonSerializer.Serialize(variantMap);
    var metaJson = JsonSerializer.Serialize(productMeta);
    var catSizeMapJson = JsonSerializer.Serialize(categorySizeTypeMap);
    var sizesJson = JsonSerializer.Serialize(sizes.Select(s => new
    {
        s.Id,
        s.MaSize,
        Group = sizeGroupMap.TryGetValue(s.Id, out var grp) ? grp : "LETTER"
    }));
    var adviceList = pricingAdvices.Values.ToList();
}

<style>
    .prod-cell { display: flex; align-items: center; gap: 12px; }
    .prod-cell img { width: 44px; height: 44px; border-radius: 10px; object-fit: cover; border: 1px solid #e2e8f0; flex-shrink: 0; }
    .stock-summary-box { display: flex; flex-direction: column; gap: 5px; }
    .stock-total-line { font-size: 13px; font-weight: 700; color: #0f172a; }
    .stock-total-line span { font-weight: 500; color: #64748b; font-size: 12px; }
    .variant-chip-list { display: flex; flex-wrap: wrap; gap: 5px; }
    .v-chip {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 2px 8px; border-radius: 6px; font-size: 11.5px; font-weight: 600;
        cursor: pointer; border: 1px solid transparent; transition: transform 0.12s ease;
    }
    .v-chip:hover { transform: translateY(-1px); }
    .v-chip-ok { background: #f0fdf4; color: #15803d; border-color: #bbf7d0; }
    .v-chip-low { background: #fffbeb; color: #b45309; border-color: #fde68a; }
    .v-chip-out { background: #fef2f2; color: #dc2626; border-color: #fecaca; }
    .v-chip-off { background: #f1f5f9; color: #64748b; border-color: #cbd5e1; text-decoration: line-through; }

    .prod-actions { display: flex; align-items: center; gap: 6px; flex-wrap: nowrap; }
    .act-btn {
        display: inline-flex; align-items: center; justify-content: center;
        height: 30px; padding: 0 10px; border-radius: 7px; font-size: 12.5px; font-weight: 500;
        line-height: 1; white-space: nowrap; text-decoration: none; cursor: pointer;
        border: 1px solid #e2e8f0; background: #ffffff; color: #334155; transition: all 0.15s ease;
    }
    .act-btn:hover { background: #f8fafc; border-color: #cbd5e1; color: #0f172a; }
    .act-variant { color: #4f46e5; border-color: #c7d2fe; background: #eef2ff; }
    .act-variant:hover { background: #e0e7ff; color: #3730a3; }
    .act-promo { color: #b45309; border-color: #fde68a; background: #fffbeb; font-weight: 600; }
    .act-promo:hover { background: #fef3c7; }
    .act-danger { color: #dc2626; border-color: #fecaca; background: #fef2f2; }
    .act-danger:hover { background: #fee2e2; }

    .color-picker-wrap { position: relative; }
    .color-suggest-popover {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        min-width: 170px;
        max-width: 240px;
        max-height: 170px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
        z-index: 60;
        padding: 4px;
    }
    .color-suggest-item {
        display: block;
        width: 100%;
        text-align: left;
        background: transparent;
        border: none;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 12.5px;
        color: #1e293b;
        cursor: pointer;
    }
    .color-suggest-item:hover {
        background: #eef2ff;
        color: #4f46e5;
        font-weight: 600;
    }

    .size-mode-badge {
        display: inline-block;
        margin-left: 6px;
        padding: 1px 7px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
        background: #eef2ff;
        color: #4f46e5;
    }

    .profit-estimator-box {
        grid-column: 1 / -1;
        background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
        border: 1px solid #c7d2fe;
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
    }
    .margin-presets {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }
    .preset-chip {
        border: 1px solid #c7d2fe;
        background: #ffffff;
        color: #4f46e5;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 9px;
        border-radius: 999px;
        cursor: pointer;
    }
    .preset-chip:hover { background: #4f46e5; color: #ffffff; }
    .profit-kpis {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
    }
    .profit-kpi-item small { display: block; font-size: 11.5px; color: #64748b; }
    .profit-kpi-item strong { font-size: 15px; color: #0f172a; }

    .trend-advisor-banner {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-left: 4px solid #4f46e5;
        border-radius: 14px;
        padding: 16px 18px;
        margin-bottom: 18px;
    }
    .trend-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 12px;
        margin-top: 12px;
    }
    .trend-card {
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        padding: 12px 14px;
        background: #fafbfc;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 10px;
    }
    .trend-card.is-hot { border-color: #bbf7d0; background: #f0fdf4; }
    .trend-card.is-slow { border-color: #fde68a; background: #fffbeb; }

    .variant-drawer {
        background: #ffffff; border: 1.5px solid #c7d2fe; border-radius: 14px;
        padding: 18px 20px; margin-bottom: 20px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }
    .variant-drawer-head {
        display: flex; justify-content: space-between; align-items: center; gap: 12px;
        padding-bottom: 12px; border-bottom: 1px solid #e2e8f0; margin-bottom: 14px;
    }
    .variant-mini-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
    .variant-mini-table th {
        text-align: left; font-size: 11.5px; text-transform: uppercase; color: #64748b;
        padding: 8px 10px; background: #f8fafc; border-bottom: 1px solid #e2e8f0;
    }
    .variant-mini-table td { padding: 8px 10px; border-bottom: 1px solid #f1f5f9; font-size: 13px; vertical-align: middle; }
    .variant-mini-table select, .variant-mini-table input {
        height: 32px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12.5px;
    }
    .add-variant-strip { background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 14px; }
</style>

<div class="page-heading">
    <div>
        <p class="eyebrow">SẢN PHẨM & ĐỊNH GIÁ</p>
        <h1>Quản lý sản phẩm</h1>
    </div>
    <button type="button" class="primary-button" onclick="openProdPanel('create-product-box')">＋ Thêm sản phẩm</button>
</div>

@if (TempData["ProductSuccess"] != null)
{
    <p style="color:#15803d;margin-bottom:12px;font-weight:500">@TempData["ProductSuccess"]</p>
}
@if (TempData["ProductError"] != null)
{
    <p style="color:#b91c1c;margin-bottom:12px;font-weight:500">@TempData["ProductError"]</p>
}

<!-- 1. KHUNG THÊM SẢN PHẨM MỚI + ƯỚC TÍNH LỢI NHUẬN TỰ ĐỘNG -->
<section id="create-product-box" class="panel" hidden style="margin-bottom:20px;padding:18px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h3 style="margin:0">Thêm sản phẩm mới & Thiết lập lợi nhuận</h3>
        <button type="button" class="act-btn" onclick="closeAllProdPanels()">✕</button>
    </div>
    <form method="post" asp-action="CreateProduct" asp-controller="Management" class="form-grid-admin">
        @Html.AntiForgeryToken()
        <label>Tên sản phẩm
            <input name="tenSanPham" required placeholder="Nhập tên sản phẩm" />
        </label>
        <label>Danh mục
            <select name="danhMucId" id="create-cat-select" required onchange="onCreateCategoryChange()">
                <option value="">-- Chọn danh mục --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.TenDanhMuc</option>
                }
            </select>
        </label>
        <label>Giá gốc / Giá nhập (VNĐ)
            <input type="number" name="giaGoc" id="create-cost" min="1000" step="1000" required oninput="recalcCreatePricing('margin')" />
        </label>
        <label>Tỷ lệ lợi nhuận (%)
            <input type="number" name="tyLeLoiNhuan" id="create-margin" min="0" max="500" step="0.5" required oninput="recalcCreatePricing('margin')" />
        </label>
        <label>Giá bán ra (VNĐ)
            <input type="number" name="giaBan" id="create-price" min="1000" step="1000" required oninput="recalcCreatePricing('price')" />
        </label>
        <label>Tồn kho ban đầu
            <input type="number" name="soLuongTon" id="create-qty" min="0" required oninput="recalcCreatePricing('margin')" />
        </label>
        <label>
            <span>
                <span id="create-size-label">Size mặc định</span>
                <span id="create-size-badge" class="size-mode-badge">Size chữ (Quần áo)</span>
            </span>
            <select name="kichThuocId" id="create-size-select" required>
                <option value="">-- Chọn size --</option>
            </select>
        </label>
        <label id="create-custom-acc-wrap" hidden>
            Hoặc nhập đại lượng / quy cách riêng
            <input type="text" name="tenKichThuocMoi" id="create-custom-acc-input" placeholder="VD: Free Size, Dây 105cm, 300ml..." />
        </label>
        <div class="color-picker-wrap">
            <label style="display:block">Màu sắc (chọn hoặc nhập màu)
                <input type="text"
                       name="tenMauMoi"
                       id="create-color-input"
                       placeholder="Chọn hoặc nhập màu sắc"
                       autocomplete="off"
                       required
                       onfocus="showColorPopover('create-color-popover', 'create-color-input')"
                       oninput="renderColorPopover('create-color-popover', 'create-color-input')" />
            </label>
            <div id="create-color-popover" class="color-suggest-popover" hidden></div>
        </div>
        <label>URL ảnh đại diện
            <input name="imageUrl" placeholder="Nhập đường dẫn ảnh" />
        </label>
        <label>Mô tả ngắn
            <input name="moTa" placeholder="Nhập mô tả sản phẩm" />
        </label>

        <div class="profit-estimator-box">
            <div>
                <div style="font-size:12.5px;font-weight:700;color:#3730a3;margin-bottom:6px">📊 Ước tính lợi nhuận bán hàng</div>
                <div class="margin-presets">
                    <span style="font-size:12px;color:#64748b">Mức lợi nhuận nhanh:</span>
                    <button type="button" class="preset-chip" onclick="setCreateMargin(20)">+20%</button>
                    <button type="button" class="preset-chip" onclick="setCreateMargin(35)">+35%</button>
                    <button type="button" class="preset-chip" onclick="setCreateMargin(50)">+50%</button>
                    <button type="button" class="preset-chip" onclick="setCreateMargin(70)">+70%</button>
                </div>
            </div>
            <div class="profit-kpis">
                <div class="profit-kpi-item">
                    <small>Lãi ròng / 1 sản phẩm</small>
                    <strong id="est-create-unit-profit" style="color:#15803d">0 đ</strong>
                </div>
                <div class="profit-kpi-item">
                    <small>Biên lãi trên doanh thu</small>
                    <strong id="est-create-rev-margin">0.0%</strong>
                </div>
                <div class="profit-kpi-item">
                    <small>Tổng lãi dự kiến lô nhập</small>
                    <strong id="est-create-batch-profit" style="color:#4f46e5">0 đ</strong>
                </div>
            </div>
        </div>

        <div style="display:flex;align-items:flex-end">
            <button type="submit" class="primary-button">Lưu sản phẩm</button>
        </div>
    </form>
</section>

<!-- 2. KHUNG CHỈNH SỬA SẢN PHẨM + CẬP NHẬT GIÁ & LỢI NHUẬN -->
<section id="edit-product-box" class="panel" hidden style="margin-bottom:20px;padding:18px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h3 style="margin:0">Chỉnh sửa sản phẩm, giá bán & tỷ lệ lợi nhuận</h3>
        <button type="button" class="act-btn" onclick="closeAllProdPanels()">✕</button>
    </div>
    <form method="post" asp-action="EditProduct" asp-controller="Management" class="form-grid-admin">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="edit-prod-id" />
        <label>Tên sản phẩm
            <input name="tenSanPham" id="edit-prod-name" required />
        </label>
        <label>Danh mục
            <select name="danhMucId" id="edit-prod-cat" required>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.TenDanhMuc</option>
                }
            </select>
        </label>
        <label>Giá gốc / Giá nhập (VNĐ)
            <input type="number" name="giaGoc" id="edit-prod-cost" min="1000" step="1000" required oninput="recalcEditPricing('margin')" />
        </label>
        <label>Tỷ lệ lợi nhuận (%)
            <input type="number" name="tyLeLoiNhuan" id="edit-prod-margin" min="0" max="500" step="0.5" required oninput="recalcEditPricing('margin')" />
        </label>
        <label>Giá bán ra (VNĐ)
            <input type="number" name="giaBan" id="edit-prod-price" min="1000" step="1000" required oninput="recalcEditPricing('price')" />
        </label>
        <label>URL ảnh đại diện
            <input name="imageUrl" id="edit-prod-img" />
        </label>
        <label style="grid-column:1 / -1">Mô tả ngắn
            <input name="moTa" id="edit-prod-desc" />
        </label>

        <div class="profit-estimator-box">
            <div style="font-size:13px;color:#334155">
                Lãi dự kiến mỗi sản phẩm bán ra: <strong id="est-edit-unit-profit" style="color:#15803d;font-size:15px">0 đ</strong>
            </div>
            <div style="display:flex;gap:8px">
                <button type="submit" class="primary-button">Lưu thay đổi</button>
            </div>
        </div>
    </form>
</section>

<!-- 3. PANEL QUẢN LÝ PHÂN LOẠI SIZE / QUY CÁCH & MÀU -->
<section id="variant-manager-box" class="variant-drawer" hidden>
    <div class="variant-drawer-head">
        <div>
            <h3 style="margin:0;font-size:16px">
                Quản lý phân loại: <span id="vm-product-name" style="color:#4f46e5"></span>
                <span id="vm-size-mode-badge" class="size-mode-badge"></span>
            </h3>
            <small id="vm-subtitle" style="color:#64748b">Chỉnh sửa Size, Màu sắc và Trạng thái từng phân loại. Muốn đổi giá bán, vui lòng dùng nút <b>Sửa</b> ở sản phẩm.</small>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            <a id="vm-goto-inventory" href="/Management/Inventory" class="act-btn act-variant">📦 Kho hàng</a>
            <button type="button" class="act-btn" onclick="closeAllProdPanels()">✕ Đóng</button>
        </div>
    </div>

    <div style="overflow-x:auto">
        <table class="variant-mini-table">
            <thead>
                <tr>
                    <th>Mã SKU</th>
                    <th id="vm-col-size-header">Kích thước (Size)</th>
                    <th>Màu sắc</th>
                    <th>Tồn kho thực tế</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody id="vm-tbody"></tbody>
        </table>
    </div>

    <div class="add-variant-strip">
        <div id="vm-add-title" style="font-size:13px;font-weight:700;color:#1e293b;margin-bottom:10px">＋ Thêm phân loại mới</div>
        <form method="post" asp-action="AddVariant" asp-controller="Management" class="form-grid-admin">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sanPhamId" id="vm-add-prod-id" />
            <input type="hidden" name="giaBan" id="vm-add-price" />
            <label><span id="vm-add-size-label">Chọn Size</span>
                <select name="kichThuocId" id="vm-add-size" required></select>
            </label>
            <label id="vm-add-custom-acc-wrap" hidden>Hoặc nhập đại lượng mới
                <input type="text" name="tenKichThuocMoi" id="vm-add-custom-acc-input" placeholder="VD: Free Size, Dây 115cm..." />
            </label>
            <div class="color-picker-wrap">
                <label style="display:block">Màu sắc (chọn hoặc nhập mới)
                    <input type="text"
                           name="tenMauMoi"
                           id="vm-add-color-input"
                           placeholder="Chọn hoặc nhập màu sắc"
                           autocomplete="off"
                           onfocus="showColorPopover('vm-add-color-popover', 'vm-add-color-input')"
                           oninput="renderColorPopover('vm-add-color-popover', 'vm-add-color-input')"
                           required />
                </label>
                <div id="vm-add-color-popover" class="color-suggest-popover" hidden></div>
            </div>
            <div style="display:flex;align-items:flex-end">
                <button type="submit" class="primary-button">Thêm phân loại</button>
            </div>
        </form>
    </div>
</section>

<!-- 4. DẢI PHÂN TÍCH XU HƯỚNG BÁN HÀNG -->
@if (adviceList.Count > 0)
{
    <section class="trend-advisor-banner">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
            <div>
                <h4 style="margin:0;font-size:15px;color:#0f172a">📈 Gợi ý điều chỉnh lợi nhuận & khuyến mãi theo dữ liệu bán hàng</h4>
                <small style="color:#64748b">Tính toán trực tiếp từ dữ liệu đơn hàng và tồn kho trong cơ sở dữ liệu.</small>
            </div>
            <span style="font-size:12px;font-weight:600;color:#4f46e5">@adviceList.Count đề xuất</span>
        </div>

        <div class="trend-cards-grid">
            @foreach (var adv in adviceList.Take(6))
            {
                <div class="trend-card @(adv.TrendType == "hot" ? "is-hot" : "is-slow")">
                    <div>
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:6px;margin-bottom:4px">
                            <strong style="font-size:13.5px;color:#0f172a">@adv.ProductName</strong>
                            <span style="font-size:11.5px;font-weight:700">@adv.TrendLabel</span>
                        </div>
                        <div style="font-size:12px;color:#475569;margin-bottom:4px">@adv.Summary</div>
                        <div style="font-size:12px;color:#1e293b;font-weight:500">@adv.ActionHint</div>
                    </div>

                    <div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center">
                        <form method="post" asp-action="ApplyProfitSuggestion" asp-controller="Management" style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@adv.ProductId" />
                            <input type="hidden" name="newMarginPercent" value="@adv.SuggestedMargin" />
                            <button type="submit" class="act-btn act-variant">
                                ✓ Đổi lãi @adv.SuggestedMargin.ToString("0.#")% (@adv.SuggestedPrice.ToString("N0") đ)
                            </button>
                        </form>

                        @if (adv.TrendType == "slow" && adv.SuggestedDiscountPercent > 0)
                        {
                            <a asp-action="Promotions" asp-controller="Management"
                               asp-route-prefillCode="@adv.SuggestedPromoCode"
                               asp-route-prefillDiscount="@adv.SuggestedDiscountPercent"
                               asp-route-prefillName="Khuyến mãi @adv.ProductName (-@adv.SuggestedDiscountPercent%)"
                               class="act-btn act-promo">
                                ⚡ Tạo mã giảm @adv.SuggestedDiscountPercent%
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- 5. THANH TÌM KIẾM & LỌC -->
<form method="get" asp-action="Products" asp-controller="Management" class="management-toolbar">
    <div class="filter-search">
        ⌕ <input name="search" value="@ViewBag.Search" placeholder="Tìm kiếm tên hoặc mã sản phẩm...">
    </div>
    <select name="categoryId" onchange="this.form.submit()">
        <option value="">Tất cả danh mục</option>
        @foreach (var c in categories)
        {
            <option value="@c.Id" selected="@(selectedCat == c.Id)">@c.TenDanhMuc</option>
        }
    </select>
    <select name="status" onchange="this.form.submit()">
        <option value="">Tất cả trạng thái</option>
        <option value="Đang bán" selected="@(selectedStatus == "Đang bán")">Đang bán</option>
        <option value="Sắp hết" selected="@(selectedStatus == "Sắp hết")">Sắp hết</option>
        <option value="Hết hàng" selected="@(selectedStatus == "Hết hàng")">Hết hàng</option>
        <option value="Ngừng bán" selected="@(selectedStatus == "Ngừng bán")">Ngừng bán</option>
    </select>
</form>

<!-- 6. BẢNG DANH SÁCH SẢN PHẨM -->
<section class="panel table-panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá gốc / Lợi nhuận</th>
                    <th>Giá bán</th>
                    <th>Tồn kho theo phân loại</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var badgeClass = item.Status switch
                    {
                        "Đang bán" => "status-success",
                        "Sắp hết" => "status-warning",
                        "Hết hàng" => "status-danger",
                        _ => "status-neutral"
                    };

                    var pVariants = variantMap.TryGetValue(item.Id, out var listV) ? listV : new List<ProductVariantInfo>();
                    var hasAdvice = pricingAdvices.TryGetValue(item.Id, out var itemAdv);

                    <tr>
                        <td>
                            <div class="prod-cell">
                                @if (!string.IsNullOrWhiteSpace(item.Image))
                                {
                                    <img src="@item.Image" alt="@item.Name">
                                }
                                <div>
                                    <strong>@item.Name</strong>
                                    <div style="font-size:12px;color:#64748b">
                                        @pVariants.Count phân loại
                                        @if (hasAdvice)
                                        {
                                            <span> • @itemAdv!.TrendLabel</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>@item.Category</td>
                        <td>
                            <div style="font-size:12.5px;color:#475569" id="row-cost-info-@item.Id"></div>
                        </td>
                        <td><strong>@item.Price.ToString("N0") đ</strong></td>
                        <td>
                            <div class="stock-summary-box">
                                <div class="stock-total-line">
                                    Tổng có thể bán: @item.Stock
                                </div>
                                <div class="variant-chip-list">
                                    @foreach (var v in pVariants)
                                    {
                                        var chipCls = !v.TrangThai
                                            ? "v-chip-off"
                                            : (v.Available <= 0 ? "v-chip-out" : (v.Available <= 5 ? "v-chip-low" : "v-chip-ok"));
                                        <span class="v-chip @chipCls"
                                              title="SKU: @v.Sku | Tồn: @v.Stock | Giữ: @v.Reserved | Giá: @v.Price.ToString("N0")đ"
                                              onclick="openVariantManager(@item.Id, @JsonSerializer.Serialize(item.Name))">
                                            @v.Size - @v.Color: <b>@v.Available</b>
                                        </span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td><span class="status-badge @badgeClass">@item.Status</span></td>
                        <td>
                            <div class="prod-actions">
                                <a asp-action="Detail" asp-controller="Shop" asp-route-id="@item.Id" target="_blank" class="act-btn">Xem</a>
                                <button type="button" class="act-btn act-variant"
                                        onclick="openVariantManager(@item.Id, @JsonSerializer.Serialize(item.Name))">
                                    Phân loại (@pVariants.Count)
                                </button>
                                <button type="button" class="act-btn"
                                        onclick="openEditProduct(@item.Id, @JsonSerializer.Serialize(item.Name))">
                                    Sửa
                                </button>
                                <form method="post" asp-action="DeleteProduct" asp-controller="Management" style="display:inline"
                                      onsubmit="return confirm('Xóa sản phẩm này?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="act-btn act-danger">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-footer"><span>Hiển thị @Model.Count sản phẩm</span></div>
</section>

<script>
    const PRODUCT_VARIANTS = @Html.Raw(variantsJson);
    const PRODUCT_META = @Html.Raw(metaJson);
    const CATEGORY_SIZE_MAP = @Html.Raw(catSizeMapJson);
    const ALL_SIZES = @Html.Raw(sizesJson);
    const ALL_COLORS = @Html.Raw(JsonSerializer.Serialize(colors.Select(c => new { c.Id, c.TenMau })));
    const ANTI_FORGERY = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    function fmtVnd(val) {
        return Math.round(val).toLocaleString('vi-VN') + ' đ';
    }

    function escapeHtml(str) {
        return String(str ?? '')
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function getSizeTypeLabel(sizeType) {
        if (sizeType === 'SHOE_ASIAN') return 'Size số châu Á (Giày dép)';
        if (sizeType === 'ACCESSORY') return 'Đại lượng / Không size (Phụ kiện)';
        return 'Size chữ (Quần áo)';
    }

    function getFilteredSizes(sizeType, extraIncludeId = null) {
        const targetGroup = sizeType || 'LETTER';
        return ALL_SIZES.filter(s => s.Group === targetGroup || (extraIncludeId && s.Id === extraIncludeId));
    }

    function onCreateCategoryChange() {
        const catId = document.getElementById('create-cat-select')?.value || '';
        const sizeType = CATEGORY_SIZE_MAP[catId] || 'LETTER';
        const filtered = getFilteredSizes(sizeType);

        const sel = document.getElementById('create-size-select');
        const lbl = document.getElementById('create-size-label');
        const badge = document.getElementById('create-size-badge');
        const customWrap = document.getElementById('create-custom-acc-wrap');
        const customInput = document.getElementById('create-custom-acc-input');

        if (badge) badge.textContent = getSizeTypeLabel(sizeType);

        if (sizeType === 'ACCESSORY') {
            if (lbl) lbl.textContent = 'Đại lượng / Quy cách';
            if (customWrap) customWrap.hidden = false;
            if (sel) {
                sel.required = false;
                sel.innerHTML = filtered.map(s => `<option value="${s.Id}">${escapeHtml(s.MaSize)}</option>`).join('');
            }
        } else {
            if (lbl) lbl.textContent = sizeType === 'SHOE_ASIAN' ? 'Size giày (Châu Á)' : 'Size mặc định';
            if (customWrap) customWrap.hidden = true;
            if (customInput) customInput.value = '';
            if (sel) {
                sel.required = true;
                const placeholder = sizeType === 'SHOE_ASIAN' ? '-- Chọn size giày --' : '-- Chọn size --';
                sel.innerHTML = `<option value="">${placeholder}</option>` +
                    filtered.map(s => `<option value="${s.Id}">${escapeHtml(s.MaSize)}</option>`).join('');
            }
        }
    }

    function hideAllColorPopovers() {
        document.querySelectorAll('.color-suggest-popover').forEach(el => el.setAttribute('hidden', ''));
    }

    function renderColorPopover(popoverId, inputId) {
        const pop = document.getElementById(popoverId);
        const inp = document.getElementById(inputId);
        if (!pop || !inp) return;

        const q = (inp.value || '').trim().toLowerCase();
        const matches = ALL_COLORS.filter(c => !q || c.TenMau.toLowerCase().includes(q));

        if (matches.length === 0) {
            pop.setAttribute('hidden', '');
            return;
        }

        pop.innerHTML = matches.map(c =>
            `<button type="button" class="color-suggest-item" onmousedown="pickColorValue('${inputId}', '${popoverId}', '${escapeHtml(c.TenMau)}')">${escapeHtml(c.TenMau)}</button>`
        ).join('');
        pop.removeAttribute('hidden');
    }

    function showColorPopover(popoverId, inputId) {
        hideAllColorPopovers();
        renderColorPopover(popoverId, inputId);
    }

    function pickColorValue(inputId, popoverId, val) {
        const inp = document.getElementById(inputId);
        if (inp) inp.value = val;
        document.getElementById(popoverId)?.setAttribute('hidden', '');
    }

    document.addEventListener('click', (e) => {
        if (!e.target.closest('.color-picker-wrap')) {
            hideAllColorPopovers();
        }
    });

    window.addEventListener('DOMContentLoaded', () => {
        onCreateCategoryChange();
        Object.keys(PRODUCT_META).forEach(id => {
            const el = document.getElementById('row-cost-info-' + id);
            const m = PRODUCT_META[id];
            if (el && m) {
                el.innerHTML = `Gốc: <b>${fmtVnd(m.GiaGoc)}</b><br><span style="color:#15803d;font-weight:600">+${m.TyLeLoiNhuan}% (+${fmtVnd(m.LoiNhuanDonVi)})</span>`;
            }
        });
    });

    function recalcCreatePricing(source) {
        const cost = parseFloat(document.getElementById('create-cost').value) || 0;
        const marginEl = document.getElementById('create-margin');
        const priceEl = document.getElementById('create-price');
        const qty = parseInt(document.getElementById('create-qty').value) || 0;

        let margin = parseFloat(marginEl.value) || 0;
        let price = parseFloat(priceEl.value) || 0;

        if (source === 'margin') {
            price = Math.round((cost * (1 + margin / 100)) / 1000) * 1000;
            priceEl.value = price;
        } else if (source === 'price' && cost > 0) {
            margin = Math.round(((price - cost) * 100 / cost) * 10) / 10;
            marginEl.value = margin;
        }

        const unitProfit = price - cost;
        const revMargin = price > 0 ? ((unitProfit / price) * 100).toFixed(1) : '0.0';
        const batchProfit = unitProfit * qty;

        document.getElementById('est-create-unit-profit').textContent = (unitProfit >= 0 ? '+' : '') + fmtVnd(unitProfit);
        document.getElementById('est-create-rev-margin').textContent = revMargin + '%';
        document.getElementById('est-create-batch-profit').textContent = (batchProfit >= 0 ? '+' : '') + fmtVnd(batchProfit);
    }

    function setCreateMargin(pct) {
        document.getElementById('create-margin').value = pct;
        recalcCreatePricing('margin');
    }

    function recalcEditPricing(source) {
        const cost = parseFloat(document.getElementById('edit-prod-cost').value) || 0;
        const marginEl = document.getElementById('edit-prod-margin');
        const priceEl = document.getElementById('edit-prod-price');

        let margin = parseFloat(marginEl.value) || 0;
        let price = parseFloat(priceEl.value) || 0;

        if (source === 'margin') {
            price = Math.round((cost * (1 + margin / 100)) / 1000) * 1000;
            priceEl.value = price;
        } else if (source === 'price' && cost > 0) {
            margin = Math.round(((price - cost) * 100 / cost) * 10) / 10;
            marginEl.value = margin;
        }

        const unitProfit = price - cost;
        document.getElementById('est-edit-unit-profit').textContent = (unitProfit >= 0 ? '+' : '') + fmtVnd(unitProfit);
    }

    function closeAllProdPanels() {
        hideAllColorPopovers();
        ['create-product-box', 'edit-product-box', 'variant-manager-box'].forEach(id => {
            document.getElementById(id)?.setAttribute('hidden', '');
        });
    }

    function openProdPanel(id) {
        const box = document.getElementById(id);
        const isHidden = box.hasAttribute('hidden');
        closeAllProdPanels();
        if (isHidden) {
            box.removeAttribute('hidden');
            box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function openEditProduct(id, name) {
        closeAllProdPanels();
        const meta = PRODUCT_META[id] || {};
        document.getElementById('edit-prod-id').value = id;
        document.getElementById('edit-prod-name').value = name;
        if (meta.DanhMucId) document.getElementById('edit-prod-cat').value = meta.DanhMucId;
        document.getElementById('edit-prod-cost').value = meta.GiaGoc ?? '';
        document.getElementById('edit-prod-margin').value = meta.TyLeLoiNhuan ?? '';
        document.getElementById('edit-prod-price').value = meta.GiaBan ?? '';
        document.getElementById('edit-prod-img').value = meta.Image ?? '';
        document.getElementById('edit-prod-desc').value = meta.MoTa ?? '';
        recalcEditPricing('price');

        const box = document.getElementById('edit-product-box');
        box.removeAttribute('hidden');
        box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function openVariantManager(productId, productName) {
        closeAllProdPanels();
        const meta = PRODUCT_META[productId] || {};
        const sizeType = meta.SizeType || 'LETTER';
        const list = PRODUCT_VARIANTS[productId] || [];

        document.getElementById('vm-product-name').textContent = productName;
        document.getElementById('vm-size-mode-badge').textContent = getSizeTypeLabel(sizeType);
        document.getElementById('vm-add-prod-id').value = productId;
        document.getElementById('vm-add-price').value = meta.GiaBan ?? '';
        document.getElementById('vm-goto-inventory').href = '/Management/Inventory?search=' + encodeURIComponent(meta.MaSanPham || productName);
        document.getElementById('vm-add-color-input').value = '';

        const isAccessory = sizeType === 'ACCESSORY';
        document.getElementById('vm-col-size-header').textContent = isAccessory
            ? 'Quy cách / Đại lượng'
            : (sizeType === 'SHOE_ASIAN' ? 'Size giày (Châu Á)' : 'Kích thước (Size)');

        document.getElementById('vm-add-title').textContent = isAccessory
            ? '＋ Thêm Quy cách / Đại lượng & Màu mới'
            : '＋ Thêm cặp Size & Màu mới';

        document.getElementById('vm-add-size-label').textContent = isAccessory
            ? 'Chọn đại lượng có sẵn'
            : (sizeType === 'SHOE_ASIAN' ? 'Chọn size giày (35–44)' : 'Chọn Size chữ');

        const addCustomWrap = document.getElementById('vm-add-custom-acc-wrap');
        const addCustomInput = document.getElementById('vm-add-custom-acc-input');
        addCustomWrap.hidden = !isAccessory;
        if (addCustomInput) addCustomInput.value = '';

        const addSizeSelect = document.getElementById('vm-add-size');
        const filteredAddSizes = getFilteredSizes(sizeType);
        addSizeSelect.innerHTML = filteredAddSizes
            .map(s => `<option value="${s.Id}">${escapeHtml(s.MaSize)}</option>`)
            .join('');

        const tbody = document.getElementById('vm-tbody');
        tbody.innerHTML = '';

        list.forEach(v => {
            const rowSizes = getFilteredSizes(sizeType, v.KichThuocId);
            const sizeOpts = rowSizes.map(s => `<option value="${s.Id}" ${s.Id === v.KichThuocId ? 'selected' : ''}>${escapeHtml(s.MaSize)}</option>`).join('');
            const popId = `vm-edit-pop-${v.Id}`;
            const inpId = `vm-edit-inp-${v.Id}`;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><code style="background:#f1f5f9;padding:3px 7px;border-radius:5px;font-size:12px">${escapeHtml(v.Sku)}</code></td>
                <td>
                    <form id="form-edit-v-${v.Id}" method="post" action="/Management/EditVariant">
                        <input type="hidden" name="__RequestVerificationToken" value="${ANTI_FORGERY}" />
                        <input type="hidden" name="variantId" value="${v.Id}" />
                        <input type="hidden" name="sanPhamId" value="${productId}" />
                        <input type="hidden" name="giaBan" value="${v.Price}" />
                    </form>
                    <select form="form-edit-v-${v.Id}" name="kichThuocId">${sizeOpts}</select>
                </td>
                <td>
                    <div class="color-picker-wrap">
                        <input form="form-edit-v-${v.Id}"
                               id="${inpId}"
                               type="text"
                               name="tenMauMoi"
                               value="${escapeHtml(v.Color)}"
                               placeholder="Nhập màu sắc"
                               autocomplete="off"
                               onfocus="showColorPopover('${popId}', '${inpId}')"
                               oninput="renderColorPopover('${popId}', '${inpId}')"
                               style="width:130px"
                               required />
                        <div id="${popId}" class="color-suggest-popover" hidden></div>
                    </div>
                </td>
                <td><strong>${v.Available}</strong> <span style="color:#64748b;font-size:12px">(Tồn: ${v.Stock} | Giữ: ${v.Reserved})</span></td>
                <td>
                    <select form="form-edit-v-${v.Id}" name="trangThai">
                        <option value="true" ${v.TrangThai ? 'selected' : ''}>Đang bán</option>
                        <option value="false" ${!v.TrangThai ? 'selected' : ''}>Tạm ẩn</option>
                    </select>
                </td>
                <td>
                    <div style="display:flex;gap:6px">
                        <button type="submit" form="form-edit-v-${v.Id}" class="act-btn act-variant">Lưu sửa</button>
                        <form method="post" action="/Management/DeleteVariant" style="display:inline"
                              onsubmit="return confirm('Xóa hoặc tạm ẩn phân loại ${escapeHtml(v.Sku)}?')">
                            <input type="hidden" name="__RequestVerificationToken" value="${ANTI_FORGERY}" />
                            <input type="hidden" name="variantId" value="${v.Id}" />
                            <input type="hidden" name="sanPhamId" value="${productId}" />
                            <button type="submit" class="act-btn act-danger">Xóa</button>
                        </form>
                    </div>
                </td>
            `;
            tbody.appendChild(tr);
        });

        const box = document.getElementById('variant-manager-box');
        box.removeAttribute('hidden');
        box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    @if (openVariantProductId.HasValue)
    {
        <text>
        window.addEventListener('DOMContentLoaded', () => {
            const targetId = @openVariantProductId.Value;
            const targetItem = @Html.Raw(JsonSerializer.Serialize(Model.Select(m => new { m.Id, m.Name })))
                .find(x => x.Id === targetId);
            if (targetItem) openVariantManager(targetItem.Id, targetItem.Name);
        });
        </text>
    }
</script>