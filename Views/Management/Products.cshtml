@model object
@{ ViewData["Title"]="Sản phẩm"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Sản phẩm</h1></div><button class="primary-button" data-bs-toggle="modal" data-bs-target="#addModal">＋ Thêm sản phẩm</button></div>
<div class="management-toolbar"><div class="filter-search">⌕ <input placeholder="Tìm kiếm sản phẩm..."></div><select class="category-filter"><option value="">Tất cả danh mục</option>@foreach(var category in ShopProject.Models.ShopDataStore.Categories){<option>@category.Name</option>}</select></div>
<section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Chọn</th><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var product in ShopProject.Models.ShopDataStore.Products){<tr data-category="@product.Category"><td><input type="checkbox"></td><td><div class="product-cell"><img src="@product.Image"><strong>@product.Name</strong></div></td><td>@product.Category</td><td>@product.Price.ToString("N0") đ</td><td>@product.Stock</td><td><span class="badge @(product.Status=="Đang bán"?"badge-success":product.Status=="Sắp hết"?"badge-warning":"badge-danger")">@product.Status</span></td><td><form method="post" asp-controller="Management" asp-action="DeleteProduct" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@product.Id"><button type="submit" class="icon-button status-save">Xóa</button></form></td></tr>}
</tbody></table></div></section>
<div class="modal fade" id="addModal"><div class="modal-dialog modal-lg"><div class="modal-content"><form method="post" asp-controller="Management" asp-action="AddProduct">@Html.AntiForgeryToken()<div class="modal-header"><h5 class="modal-title">Thêm sản phẩm mới</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="form-grid-admin"><label>Tên sản phẩm<input name="name" required></label><label>Danh mục<select name="category">@foreach(var category in ShopProject.Models.ShopDataStore.Categories){<option>@category.Name</option>}</select></label><label>Giá bán<input name="price" type="number" min="0" required></label><label>Tồn kho<input name="stock" type="number" min="0" required></label><label class="full">URL hình ảnh<input name="image" type="url" placeholder="https://..."></label></div></div><div class="modal-footer"><button type="button" class="secondary-button" data-bs-dismiss="modal">Hủy</button><button type="submit" class="primary-button">Lưu sản phẩm</button></div></form></div></div></div>