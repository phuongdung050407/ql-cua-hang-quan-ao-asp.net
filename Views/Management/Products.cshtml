@{ ViewData["Title"]="Sản phẩm"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Sản phẩm</h1></div><button class="primary-button" data-bs-toggle="modal" data-bs-target="#addModal">＋ Thêm sản phẩm</button></div>
<div class="management-toolbar"><div class="filter-search">⌕ <input placeholder="Tìm kiếm sản phẩm..."></div><select><option>Tất cả danh mục</option><option>Áo sơ mi</option><option>Váy đầm</option></select><select><option>Tất cả trạng thái</option></select></div>
<section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Chọn</th><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var p in new[]{("Áo sơ mi linen","Áo sơ mi","450.000 đ","20","Đang bán","photo-1602810318383-e386cc2a3ccf"),("Váy hoa midi","Váy đầm","680.000 đ","14","Đang bán","photo-1595777457583-95e059d581b8"),("Quần jean slim","Quần","550.000 đ","3","Sắp hết","photo-1542272604-787c3835535d"),("Áo khoác denim","Áo khoác","890.000 đ","0","Hết hàng","photo-1523205771623-e0faa4d2813d")}){<tr><td><input type="checkbox"></td><td><div class="product-cell"><img src="https://images.unsplash.com/@p.Item6?w=100"><strong>@p.Item1</strong></div></td><td>@p.Item2</td><td>@p.Item3</td><td>@p.Item4</td><td><span class="badge @(p.Item5=="Đang bán"?"badge-success":p.Item5=="Sắp hết"?"badge-warning":"badge-danger")">@p.Item5</span></td><td><select class="action-select"><option value="">Thao tác</option><option value="view">Xem</option><option value="edit">Sửa</option><option value="delete">Xóa</option></select></td></tr>}
</tbody></table></div><div class="table-footer"><span>Hiển thị 1-4 trên 48 sản phẩm</span><div><button>‹</button><button class="active">1</button><button>2</button><button>3</button><button>›</button></div></div></section>
<div class="modal fade" id="addModal"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Thêm sản phẩm mới</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="form-grid-admin"><label>Tên sản phẩm<input></label><label>Danh mục<select><option>Áo sơ mi</option></select></label><label>Giá bán<input></label><label>Tồn kho<input></label><label class="full">Mô tả<textarea></textarea></label></div></div><div class="modal-footer"><button class="secondary-button" data-bs-dismiss="modal">Hủy</button><button class="primary-button">Lưu sản phẩm</button></div></div></div></div>