@model List<ShopProject.Models.Entities.TinhThanh>
@{
    ViewData["Title"] = "Khu vực giao hàng";
}

<style>
    .prov-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
    }
    .prov-actions form {
        margin: 0;
        display: inline-flex;
    }
    .act-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 30px;
        padding: 0 11px;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.15s ease;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #334155;
    }
    .act-btn:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #0f172a;
    }
    .act-disable {
        color: #b45309;
        border-color: #fde68a;
        background: #fffbeb;
    }
    .act-disable:hover {
        background: #fef3c7;
        border-color: #fcd34d;
    }
    .act-enable {
        color: #15803d;
        border-color: #bbf7d0;
        background: #f0fdf4;
    }
    .act-enable:hover {
        background: #dcfce7;
        border-color: #86efac;
    }
    .act-delete {
        color: #dc2626;
        border-color: #fecaca;
        background: #fef2f2;
    }
    .act-delete:hover {
        background: #fee2e2;
        border-color: #fca5a5;
        color: #b91c1c;
    }
</style>

<div class="page-heading">
    <div>
        <p class="eyebrow">QUẢN LÝ BÁN HÀNG</p>
        <h1>Khu vực giao hàng (Tỉnh / Thành)</h1>
    </div>
    <button type="button" class="primary-button" onclick="openProvBox('add-province-box')">＋ Thêm khu vực</button>
</div>

@if (TempData["ProvinceSuccess"] != null)
{
    <p style="color:#15803d;margin-bottom:12px">@TempData["ProvinceSuccess"]</p>
}
@if (TempData["ProvinceError"] != null)
{
    <p style="color:#b91c1c;margin-bottom:12px">@TempData["ProvinceError"]</p>
}

<!-- 1. KHUNG THÊM KHU VỰC MỚI -->
<section id="add-province-box" class="panel" hidden style="margin-bottom:20px;padding:18px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h3 style="margin:0">Thêm Tỉnh / Thành phố hỗ trợ giao hàng</h3>
        <button type="button" class="act-btn" onclick="closeAllProvBoxes()">✕</button>
    </div>
    <form method="post" asp-action="CreateProvince" asp-controller="Management" class="form-grid-admin">
        @Html.AntiForgeryToken()
        <label class="full">Tên Tỉnh / Thành phố
            <input name="tenTinhThanh" required placeholder="Ví dụ: Đồng Tháp, Tiền Giang..." />
        </label>
        <div class="full">
            <button type="submit" class="primary-button">Lưu khu vực</button>
        </div>
    </form>
</section>

<!-- 2. KHUNG SỬA TÊN KHU VỰC -->
<section id="edit-province-box" class="panel" hidden style="margin-bottom:20px;padding:18px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <h3 style="margin:0">Chỉnh sửa tên khu vực giao hàng</h3>
        <button type="button" class="act-btn" onclick="closeAllProvBoxes()">✕</button>
    </div>
    <form method="post" asp-action="EditProvince" asp-controller="Management" class="form-grid-admin">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="edit-prov-id" />
        <label class="full">Tên Tỉnh / Thành phố
            <input name="tenTinhThanh" id="edit-prov-name" required />
        </label>
        <div class="full">
            <button type="submit" class="primary-button">Cập nhật khu vực</button>
        </div>
    </form>
</section>

<!-- 3. BẢNG DANH SÁCH KHU VỰC GIAO HÀNG -->
<section class="panel table-panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Tỉnh / Thành phố</th>
                    <th>Phạm vi áp dụng</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td><strong>@t.TenTinhThanh</strong></td>
                        <td style="color:#64748b">@(t.TrangThai ? "Cho phép đặt hàng online" : "Tạm ngưng nhận đơn")</td>
                        <td>
                            <span class="badge @(t.TrangThai ? "badge-success" : "badge-danger")">
                                @(t.TrangThai ? "Đang mở" : "Đã khóa")
                            </span>
                        </td>
                        <td>
                            <div class="prov-actions">
                                <button type="button" class="act-btn"
                                        data-id="@t.Id"
                                        data-name="@t.TenTinhThanh"
                                        onclick="openEditProvModal(this)">Sửa</button>

                                <form method="post" asp-action="ToggleProvince" asp-controller="Management">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="act-btn @(t.TrangThai ? "act-disable" : "act-enable")">
                                        @(t.TrangThai ? "Tạm ngưng" : "Mở lại")
                                    </button>
                                </form>

                                <form method="post" asp-action="DeleteProvince" asp-controller="Management"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa khu vực @t.TenTinhThanh?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="act-btn act-delete">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-footer"><span>Tổng cộng @Model.Count khu vực</span></div>
</section>

<script>
    function closeAllProvBoxes() {
        ['add-province-box', 'edit-province-box'].forEach(id => {
            document.getElementById(id)?.setAttribute('hidden', '');
        });
    }

    function openProvBox(boxId) {
        const box = document.getElementById(boxId);
        const isHidden = box.hasAttribute('hidden');
        closeAllProvBoxes();
        if (isHidden) {
            box.removeAttribute('hidden');
            box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function openEditProvModal(btn) {
        closeAllProvBoxes();
        document.getElementById('edit-prov-id').value = btn.dataset.id;
        document.getElementById('edit-prov-name').value = btn.dataset.name;
        const box = document.getElementById('edit-province-box');
        box.removeAttribute('hidden');
        box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
</script>