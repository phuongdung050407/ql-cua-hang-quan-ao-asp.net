@model ShopProject.Controllers.SalesReportSnapshot
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Báo cáo doanh thu T@(Model.SelectedMonth)/@Model.SelectedYear - @Model.ReportCode</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f1f5f9;
            color: #0f172a;
            margin: 0;
            padding: 24px;
        }
        .toolbar {
            max-width: 820px;
            margin: 0 auto 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #ffffff;
            padding: 12px 18px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            height: 36px;
            padding: 0 14px;
            border-radius: 8px;
            font-size: 13.5px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #1e293b;
            cursor: pointer;
        }
        .btn-primary {
            background: #4f46e5;
            border-color: #4f46e5;
            color: #ffffff;
        }
        .sheet {
            max-width: 820px;
            margin: 0 auto;
            background: #ffffff;
            padding: 38px 42px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
        }
        .sheet-head {
            display: flex;
            justify-content: space-between;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 16px;
            margin-bottom: 20px;
        }
        .title-center {
            text-align: center;
            margin-bottom: 22px;
        }
        .kpi-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 22px;
        }
        .kpi-item {
            border: 1px solid #cbd5e1;
            background: #f8fafc;
            border-radius: 8px;
            padding: 10px 12px;
        }
        .kpi-item small { color: #64748b; display: block; font-size: 11.5px; }
        .kpi-item strong { font-size: 15px; display: block; margin-top: 3px; }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 22px;
            font-size: 13px;
        }
        th {
            background: #1e293b;
            color: #ffffff;
            text-align: left;
            padding: 8px 10px;
        }
        td {
            border-bottom: 1px solid #e2e8f0;
            padding: 7px 10px;
        }
        .num { text-align: right; }
        .highlight-row { background: #eef2ff; font-weight: 700; }
        .sign-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            text-align: center;
            margin-top: 30px;
            font-size: 13px;
        }
        @@media print {
            body { background: #fff; padding: 0; }
            .toolbar { display: none; }
            .sheet { box-shadow: none; padding: 12px; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <a asp-action="Reports" asp-controller="Management"
           asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth" class="btn">
            ← Quay lại Báo cáo
        </a>
        <div style="display:flex;gap:8px">
            <form method="post" asp-action="ExportReportPdf" asp-controller="Management" style="display:inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.SelectedYear" />
                <input type="hidden" name="month" value="@Model.SelectedMonth" />
                <button type="submit" class="btn btn-primary">⬇ Tải file PDF & Lưu trữ</button>
            </form>
        </div>
    </div>

    <div class="sheet">
        <div class="sheet-head">
            <div>
                <div style="font-size:18px;font-weight:800;color:#4f46e5">FASHIONHUB STORE</div>
                <div style="font-size:12.5px;color:#64748b">Hệ thống quản lý kinh doanh thời trang</div>
            </div>
            <div style="text-align:right;font-size:12.5px;color:#475569">
                <div><strong>Mã báo cáo:</strong> @Model.ReportCode</div>
                <div><strong>Ngày lập:</strong> @Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="title-center">
            <h2 style="margin:0 0 4px">BÁO CÁO TỔNG HỢP DOANH THU & BÁN HÀNG</h2>
            <div style="color:#475569;font-size:13.5px">Kỳ báo cáo: Tháng @Model.SelectedMonth.ToString("00")/@Model.SelectedYear (Lũy kế năm @Model.SelectedYear)</div>
        </div>

        <div class="kpi-row">
            <div class="kpi-item">
                <small>Doanh thu tháng @Model.SelectedMonth</small>
                <strong>@Model.MonthRevenue.ToString("N0") đ</strong>
            </div>
            <div class="kpi-item">
                <small>Đơn hàng hợp lệ</small>
                <strong>@Model.MonthOrders đơn</strong>
            </div>
            <div class="kpi-item">
                <small>Khách hàng mới</small>
                <strong>@Model.NewCustomers khách</strong>
            </div>
            <div class="kpi-item">
                <small>Giá trị đơn trung bình</small>
                <strong>@Model.AvgOrder.ToString("N0") đ</strong>
            </div>
        </div>

        <h4 style="margin:0 0 8px">I. Chi tiết doanh thu 12 tháng năm @Model.SelectedYear</h4>
        <table>
            <thead>
                <tr>
                    <th>Tháng</th>
                    <th class="num">Số đơn hàng</th>
                    <th class="num">Doanh thu</th>
                    <th class="num">Trung bình / đơn</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.MonthlyBreakdown)
                {
                    <tr class="@(m.Month == Model.SelectedMonth ? "highlight-row" : "")">
                        <td>Tháng @m.Month.ToString("00")</td>
                        <td class="num">@m.OrderCount</td>
                        <td class="num">@m.Revenue.ToString("N0") đ</td>
                        <td class="num">@m.AvgOrder.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 style="margin:0 0 8px">II. Top sản phẩm bán chạy năm @Model.SelectedYear</h4>
        <table>
            <thead>
                <tr>
                    <th style="width:45px">STT</th>
                    <th>Tên sản phẩm</th>
                    <th class="num">Số lượng bán</th>
                    <th class="num">Doanh thu</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.TopProducts.Count; i++)
                {
                    var p = Model.TopProducts[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@p.Name</td>
                        <td class="num">@p.Stock sp</td>
                        <td class="num"><strong>@p.Price.ToString("N0") đ</strong></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="sign-row">
            <div>
                <strong>NGƯỜI LẬP BÁO CÁO</strong>
                <div style="color:#64748b;font-size:12px">(Ký và ghi rõ họ tên)</div>
            </div>
            <div>
                <strong>QUẢN LÝ CỬA HÀNG</strong>
                <div style="color:#64748b;font-size:12px">(Xác nhận & đóng dấu)</div>
            </div>
        </div>
    </div>
</body>
</html>