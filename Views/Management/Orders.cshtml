@{ ViewData["Title"]="Đơn đặt hàng"; }
<div class="page-heading"><div><p class="eyebrow">BÁN HÀNG</p><h1>Đơn đặt hàng</h1></div><button class="primary-button">＋ Tạo đơn hàng</button></div>
<div class="stats-grid people-stats"><article class="stat-card"><div class="stat-icon amber">◷</div><div><p>Chờ xử lý</p><strong>8</strong></div></article><article class="stat-card"><div class="stat-icon blue">▻</div><div><p>Đang giao</p><strong>12</strong></div></article><article class="stat-card"><div class="stat-icon green">✓</div><div><p>Hoàn tất</p><strong>64</strong></div></article><article class="stat-card"><div class="stat-icon violet">◆</div><div><p>Tổng đơn tháng</p><strong>96</strong></div></article></div>
<section class="panel table-panel"><div class="management-toolbar"><div class="filter-search">⌕ <input placeholder="Tìm mã đơn, khách hàng..."></div><select><option>Tất cả trạng thái</option><option>Chờ xử lý</option><option>Đang giao</option></select></div><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var o in new[]{("DH-26011","Nguyễn Minh Anh","19/11/2026","1.450.000 đ","Đã thanh toán","Hoàn tất"),("DH-26010","Trần Quốc Bảo","19/11/2026","890.000 đ","COD","Đang giao"),("DH-26009","Lê Thu Hà","18/11/2026","2.240.000 đ","Đã thanh toán","Chờ xử lý"),("DH-26008","Phạm Văn Nam","18/11/2026","720.000 đ","COD","Đang giao")}){<tr><td><strong>@o.Item1</strong></td><td>@o.Item2</td><td>@o.Item3</td><td>@o.Item4</td><td>@o.Item5</td><td><span class="badge @(o.Item6=="Hoàn tất"?"badge-success":o.Item6=="Chờ xử lý"?"badge-warning":"badge-blue")">@o.Item6</span></td><td><button class="icon-button">⋯</button></td></tr>}</tbody></table></div></section>