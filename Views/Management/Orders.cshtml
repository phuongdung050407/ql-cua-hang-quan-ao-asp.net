@model List<ShopProject.Models.Entities.DonHang>
@{
    ViewData["Title"] = "Đơn đặt hàng";
    var selectedStatus = (ViewBag.Status as string ?? "").Trim();
}
<div class="page-heading">
    <div>
        <p class="eyebrow">BÁN HÀNG</p>
        <h1>Đơn đặt hàng</h1>
    </div>
    <a asp-action="Payments" asp-controller="Management" class="btn-invoice">
        <span>💳</span> Quản lý thanh toán CK
    </a>
</div>
<style>
    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }
    .order-code-link {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 12.5px;
        font-weight: 600;
        color: #4f46e5;
        background: #f5f3ff;
        border: 1px solid #e0e7ff;
        padding: 4px 8px;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.15s ease;
    }
    .order-code-link:hover {
        background: #eef2ff;
        border-color: #c7d2fe;
        color: #3730a3;
    }
    .customer-cell {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .customer-cell strong {
        color: #0f172a;
        font-size: 13.5px;
        font-weight: 600;
    }
    .customer-cell span {
        color: #64748b;
        font-size: 12.5px;
    }
    .pay-stack {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
    }
    .pay-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 9px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
    }
    .pay-sub-paid {
        font-size: 11.5px;
        font-weight: 600;
        color: #15803d;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        padding: 1px 7px;
        border-radius: 999px;
    }
    .pay-sub-unpaid {
        font-size: 11.5px;
        font-weight: 600;
        color: #b45309;
        background: #fffbeb;
        border: 1px solid #fde68a;
        padding: 1px 7px;
        border-radius: 999px;
    }
    .status-form-inline {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 0;
    }
    .status-form-inline .status-select {
        height: 30px;
        padding: 0 26px 0 10px;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #0f172a;
    }
    .status-form-inline .status-select.st-Cho_xac_nhan {
        background: #fffbeb;
        border-color: #fde68a;
        color: #b45309;
    }
    .status-form-inline .status-select.st-Da_xac_nhan {
        background: #eef2ff;
        border-color: #c7d2fe;
        color: #4338ca;
    }
    .status-form-inline .status-select.st-Dang_giao {
        background: #eff6ff;
        border-color: #bfdbfe;
        color: #1d4ed8;
    }
    .status-form-inline .status-select.st-Da_giao {
        background: #f0fdf4;
        border-color: #bbf7d0;
        color: #15803d;
    }
    .status-form-inline .status-select.st-Da_huy {
        background: #fef2f2;
        border-color: #fecaca;
        color: #dc2626;
    }
    .status-form-inline .status-select option {
        background: #ffffff;
        color: #0f172a;
    }
    .act-group {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
    }
    .act-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 30px;
        padding: 0 11px;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #334155;
    }
    .act-btn:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #0f172a;
    }
    .act-save {
        color: #4f46e5;
        border-color: #c7d2fe;
        background: #eef2ff;
    }
    .act-save:hover {
        background: #e0e7ff;
        border-color: #a5b4fc;
        color: #3730a3;
    }
    .act-track-pay {
        color: #b45309;
        border-color: #fde68a;
        background: #fffbeb;
        font-weight: 600;
    }
    .act-track-pay:hover {
        background: #fef3c7;
        border-color: #f59e0b;
        color: #92400e;
    }
    .table-wrap td a.btn-invoice,
    a.btn-invoice {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 30px;
        padding: 0 12px;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        text-decoration: none !important;
        cursor: pointer;
        transition: all 0.15s ease;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #1e293b !important;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .table-wrap td a.btn-invoice:hover,
    a.btn-invoice:hover {
        background: #f8fafc;
        border-color: #4f46e5;
        color: #4f46e5 !important;
        box-shadow: 0 2px 4px rgba(79, 70, 229, 0.1);
    }
</style>

@if (TempData["OrderSuccess"] != null)
{
    <p style="color:#15803d;margin-bottom:12px;font-weight:500">@TempData["OrderSuccess"]</p>
}
@if (TempData["OrderError"] != null)
{
    <p style="color:#b91c1c;margin-bottom:12px;font-weight:500">@TempData["OrderError"]</p>
}

<div class="stats-grid people-stats">
    <article class="stat-card">
        <div class="stat-icon amber">◷</div>
        <div><p>Chờ xử lý</p><strong>@ViewBag.PendingCount</strong></div>
    </article>
    <article class="stat-card">
        <div class="stat-icon blue">▻</div>
        <div><p>Đang giao</p><strong>@ViewBag.ShippingCount</strong></div>
    </article>
    <article class="stat-card">
        <div class="stat-icon green">✓</div>
        <div><p>Hoàn tất</p><strong>@ViewBag.CompletedCount</strong></div>
    </article>
    <article class="stat-card">
        <div class="stat-icon violet">◆</div>
        <div><p>Tổng đơn tháng</p><strong>@ViewBag.MonthCount</strong></div>
    </article>
</div>

<section class="panel table-panel">
    <form method="get" asp-action="Orders" asp-controller="Management" class="management-toolbar">
        <div class="filter-search">
            ⌕ <input name="search" value="@ViewBag.Search" placeholder="Tìm mã đơn, khách hàng, SĐT...">
        </div>
        <select name="status" onchange="this.form.submit()">
            <option value="">Tất cả trạng thái</option>
            <option value="Cho_xac_nhan" selected="@(selectedStatus == "Cho_xac_nhan")">Chờ xác nhận</option>
            <option value="Da_xac_nhan" selected="@(selectedStatus == "Da_xac_nhan")">Đã xác nhận</option>
            <option value="Dang_giao" selected="@(selectedStatus == "Dang_giao")">Đang giao</option>
            <option value="Da_giao" selected="@(selectedStatus == "Da_giao")">Hoàn tất</option>
            <option value="Da_huy" selected="@(selectedStatus == "Da_huy")">Đã hủy</option>
        </select>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var st = (o.TrangThai ?? "").Trim();
                    var pm = (o.PhuongThucThanhToan ?? "").Trim();
                    var ps = (o.TrangThaiThanhToan ?? "").Trim();
                    var isTransfer = string.Equals(pm, "Chuyen_khoan", StringComparison.OrdinalIgnoreCase)
                                     || string.Equals(pm, "ChuyenKhoan", StringComparison.OrdinalIgnoreCase)
                                     || pm.Contains("bank", StringComparison.OrdinalIgnoreCase)
                                     || pm.Contains("qr", StringComparison.OrdinalIgnoreCase);
                    var isPaid = string.Equals(ps, "Da_thanh_toan", StringComparison.OrdinalIgnoreCase);

                    <tr>
                        <td>
                            <a href="/Shop/Invoice/@o.MaDonHang" target="_blank" class="order-code-link">@o.MaDonHang</a>
                        </td>
                        <td>
                            <div class="customer-cell">
                                <strong>@o.TenNguoiNhan</strong>
                                <span>@o.DienThoaiNhan</span>
                            </div>
                        </td>
                        <td>@o.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@o.TongThanhToan.ToString("N0") đ</td>
                        <td>
                            <div class="pay-stack">
                                <span class="pay-badge">@pm</span>
                                @if (isTransfer)
                                {
                                    if (isPaid)
                                    {
                                        <span class="pay-sub-paid">Đã xác nhận CK</span>
                                    }
                                    else
                                    {
                                        <span class="pay-sub-unpaid">Chờ xác nhận CK</span>
                                    }
                                }
                            </div>
                        </td>
                        <td>
                            <form method="post" asp-action="UpdateOrderStatus" asp-controller="Management" class="status-form-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@o.Id" />
                                <select name="status" class="status-select st-@st" onchange="this.className='status-select st-' + this.value">
                                    <option value="Cho_xac_nhan" selected="@(string.Equals(st, "Cho_xac_nhan", StringComparison.OrdinalIgnoreCase))">Chờ xác nhận</option>
                                    <option value="Da_xac_nhan" selected="@(string.Equals(st, "Da_xac_nhan", StringComparison.OrdinalIgnoreCase))">Đã xác nhận</option>
                                    <option value="Dang_giao" selected="@(string.Equals(st, "Dang_giao", StringComparison.OrdinalIgnoreCase))">Đang giao</option>
                                    <option value="Da_giao" selected="@(string.Equals(st, "Da_giao", StringComparison.OrdinalIgnoreCase))">Hoàn tất</option>
                                    <option value="Da_huy" selected="@(string.Equals(st, "Da_huy", StringComparison.OrdinalIgnoreCase))">Đã hủy</option>
                                </select>
                                <button type="submit" class="act-btn act-save">Lưu</button>
                            </form>
                        </td>
                        <td>
                            <div class="act-group">
                                @if (isTransfer)
                                {
                                    <a asp-action="Payments" asp-controller="Management" asp-route-search="@o.MaDonHang" class="act-btn act-track-pay">
                                        💳 Theo dõi TT
                                    </a>
                                }
                                <a href="/Shop/Invoice/@o.MaDonHang" target="_blank" class="btn-invoice">
                                    <span>▤</span> Xem hóa đơn
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-footer"><span>Tổng cộng @Model.Count đơn hàng</span></div>
</section>