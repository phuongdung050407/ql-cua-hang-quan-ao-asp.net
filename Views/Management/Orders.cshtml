@{ ViewData["Title"]="Đơn đặt hàng"; }
<div class="page-heading"><div><p class="eyebrow">BÁN HÀNG</p><h1>Đơn đặt hàng</h1></div><button class="primary-button">＋ Tạo đơn hàng</button></div>
<div class="stats-grid people-stats"><article class="stat-card"><div class="stat-icon amber">◷</div><div><p>Chờ xử lý</p><strong>8</strong></div></article><article class="stat-card"><div class="stat-icon blue">▻</div><div><p>Đang giao</p><strong>12</strong></div></article><article class="stat-card"><div class="stat-icon green">✓</div><div><p>Hoàn tất</p><strong>64</strong></div></article><article class="stat-card"><div class="stat-icon violet">◆</div><div><p>Tổng đơn tháng</p><strong>96</strong></div></article></div>
<section class="panel table-panel"><div class="management-toolbar"><div class="filter-search">⌕ <input placeholder="Tìm mã đơn, khách hàng..."></div><select><option>Tất cả trạng thái</option><option>Chờ xử lý</option><option>Đang giao</option></select></div><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var order in ShopProject.Models.ShopDataStore.Orders){<tr><td><strong>@order.Code</strong></td><td>@order.Customer</td><td>@order.Date</td><td>@order.Total.ToString("N0") đ</td><td>Đã thanh toán/COD</td><td><select name="status" class="status-select order-status" data-code="@order.Code" data-current="@order.Status"><option>Chờ xử lý</option><option>Đang xử lý</option><option>Đang giao</option><option>Hoàn tất</option><option>Đã hủy</option></select></td><td><button type="button" class="icon-button order-status-save" data-code="@order.Code">Lưu</button></td></tr>}</tbody></table></div></section>