@model List<ShopProject.Models.DonHang>
@{
    ViewData["Title"] = "Đơn đặt hàng";
    string MapStatus(string? s) => (s ?? "").Trim() switch
    {
        "Cho_xac_nhan" => "Chờ xử lý",
        "Da_xac_nhan" => "Đang xử lý",
        "Dang_giao" => "Đang giao",
        "Da_giao" => "Hoàn tất",
        "Da_huy" => "Đã hủy",
        _ => "Chờ xử lý"
    };
}

<style>
    .order-code-link {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 12.5px;
        font-weight: 600;
        color: #4f46e5;
        background: #f5f3ff;
        border: 1px solid #e0e7ff;
        padding: 4px 8px;
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.15s ease;
    }
    .order-code-link:hover {
        background: #eef2ff;
        border-color: #c7d2fe;
        color: #3730a3;
    }
    .act-group {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
        justify-content: flex-end;
    }
    .act-track-pay {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 30px;
        padding: 0 10px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        text-decoration: none;
        color: #b45309;
        border: 1px solid #fde68a;
        background: #fffbeb;
    }
    .act-track-pay:hover {
        background: #fef3c7;
        border-color: #f59e0b;
        color: #92400e;
    }
    .table-wrap td a.btn-invoice,
    a.btn-invoice {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 30px;
        padding: 0 12px;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        text-decoration: none !important;
        cursor: pointer;
        transition: all 0.15s ease;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #1e293b !important;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .table-wrap td a.btn-invoice:hover,
    a.btn-invoice:hover {
        background: #f8fafc;
        border-color: #4f46e5;
        color: #4f46e5 !important;
        box-shadow: 0 2px 4px rgba(79, 70, 229, 0.1);
    }
</style>

<div class="page-heading">
    <div>
        <p class="eyebrow">VẬN HÀNH BÁN HÀNG</p>
        <h1>Đơn đặt hàng</h1>
    </div>
    <div style="display:inline-flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <a asp-action="Payments" asp-controller="Management" class="btn-invoice">
            <span>💳</span> Quản lý thanh toán CK
        </a>
        <a href="/Shop" class="primary-button"><i class="bi bi-plus-lg"></i> Tạo đơn tại quầy</a>
    </div>
</div>

@if (TempData["OrderSuccess"] != null)
{
    <p style="color:#15803d;margin-bottom:12px;font-weight:500">@TempData["OrderSuccess"]</p>
}
@if (TempData["OrderError"] != null)
{
    <p style="color:#b91c1c;margin-bottom:12px;font-weight:500">@TempData["OrderError"]</p>
}

<div class="stats-grid people-stats">
    <article class="stat-card">
        <div class="stat-icon amber"><i class="bi bi-clock-history"></i></div>
        <div><p>Chờ xử lý</p><strong>@(ViewBag.PendingCount ?? 0)</strong></div>
    </article>
    <article class="stat-card">
        <div class="stat-icon blue"><i class="bi bi-truck"></i></div>
        <div><p>Đang giao</p><strong>@(ViewBag.ShippingCount ?? 0)</strong></div>
    </article>
    <article class="stat-card">
        <div class="stat-icon green"><i class="bi bi-check2-circle"></i></div>
        <div><p>Hoàn tất</p><strong>@(ViewBag.CompletedCount ?? 0)</strong></div>
    </article>
    <article class="stat-card">
        <div class="stat-icon violet"><i class="bi bi-bag-check"></i></div>
        <div><p>Tổng đơn hàng</p><strong>@(ViewBag.TotalMonthCount ?? Model.Count)</strong></div>
    </article>
</div>

<section class="panel table-panel">
    <div class="management-toolbar" style="padding: 18px 20px 10px;">
        <div class="order-filter-tabs" id="orderTabs">
            <button type="button" class="filter-tab active" data-filter="ALL">Tất cả (@Model.Count)</button>
            <button type="button" class="filter-tab" data-filter="Chờ xử lý">Chờ xử lý</button>
            <button type="button" class="filter-tab" data-filter="Đang xử lý">Đang xử lý</button>
            <button type="button" class="filter-tab" data-filter="Đang giao">Đang giao</button>
            <button type="button" class="filter-tab" data-filter="Hoàn tất">Hoàn tất</button>
            <button type="button" class="filter-tab" data-filter="Đã hủy">Đã hủy</button>
        </div>
        <div class="filter-search">
            <i class="bi bi-search text-muted"></i>
            <input type="text" id="orderSearchInput" placeholder="Tìm mã đơn, tên hoặc SĐT khách...">
        </div>
    </div>

    <div class="table-wrap">
        <table id="ordersTable">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th>Xử lý nhanh</th>
                    <th class="text-end">Hóa đơn</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var vnStatus = MapStatus(o.TrangThai);
                    var pm = (o.PhuongThucThanhToan ?? "").Trim();
                    var isTransfer = string.Equals(pm, "Chuyen_khoan", StringComparison.OrdinalIgnoreCase)
                                     || string.Equals(pm, "ChuyenKhoan", StringComparison.OrdinalIgnoreCase)
                                     || pm.Contains("bank", StringComparison.OrdinalIgnoreCase)
                                     || pm.Contains("qr", StringComparison.OrdinalIgnoreCase);

                    var badgeClass = vnStatus switch
                    {
                        "Chờ xử lý" => "badge-warning",
                        "Đang xử lý" => "badge-info",
                        "Đang giao" => "badge-primary",
                        "Hoàn tất" => "badge-success",
                        "Đã hủy" => "badge-danger",
                        _ => "badge-warning"
                    };
                    var nextStep = vnStatus switch
                    {
                        "Chờ xử lý" => "Đang xử lý",
                        "Đang xử lý" => "Đang giao",
                        "Đang giao" => "Hoàn tất",
                        _ => ""
                    };
                    var nextLabel = vnStatus switch
                    {
                        "Chờ xử lý" => "✓ Xác nhận đơn",
                        "Đang xử lý" => "🚚 Giao vận chuyển",
                        "Đang giao" => "✓ Hoàn tất đơn",
                        _ => ""
                    };

                    <tr data-status="@vnStatus">
                        <td>
                            <a href="/Shop/Invoice/@o.MaDonHang" target="_blank" class="order-code-link">@o.MaDonHang</a>
                        </td>
                        <td>
                            <strong>@o.TenNguoiNhan</strong><br>
                            <small style="color:#6b7280">@o.DienThoaiNhan</small>
                        </td>
                        <td>@o.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><strong>@o.TongThanhToan.ToString("N0") đ</strong></td>
                        <td>
                            <span class="payment-pill @(o.TrangThaiThanhToan == "Da_thanh_toan" ? "paid" : "cod")">
                                @(o.TrangThaiThanhToan == "Da_thanh_toan" ? "Đã thanh toán" : o.PhuongThucThanhToan)
                            </span>
                        </td>
                        <td>
                            <span class="badge @badgeClass">@vnStatus</span>
                        </td>
                        <td>
                            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                @if (!string.IsNullOrEmpty(nextStep))
                                {
                                    <form method="post" action="/Management/UpdateOrderStatus" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <input type="hidden" name="status" value="@nextStep" />
                                        <button type="submit" class="btn-quick-step">@nextLabel</button>
                                    </form>
                                }
                                <form method="post" action="/Management/UpdateOrderStatus" style="display:flex;gap:6px;align-items:center;margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <select name="status" class="status-select order-status">
                                        <option value="Chờ xử lý" selected="@(vnStatus == "Chờ xử lý")">Chờ xử lý</option>
                                        <option value="Đang xử lý" selected="@(vnStatus == "Đang xử lý")">Đang xử lý</option>
                                        <option value="Đang giao" selected="@(vnStatus == "Đang giao")">Đang giao</option>
                                        <option value="Hoàn tất" selected="@(vnStatus == "Hoàn tất")">Hoàn tất</option>
                                        <option value="Đã hủy" selected="@(vnStatus == "Đã hủy")">Đã hủy</option>
                                    </select>
                                    <button type="submit" class="icon-button" style="padding:5px 12px;border-radius:8px;">Lưu</button>
                                </form>
                            </div>
                        </td>
                        <td class="text-end">
                            <div class="act-group">
                                @if (isTransfer)
                                {
                                    <a asp-action="Payments" asp-controller="Management" asp-route-search="@o.MaDonHang" class="act-track-pay">
                                        💳 Theo dõi TT
                                    </a>
                                }
                                <a href="/Shop/Invoice/@o.MaDonHang" target="_blank" class="btn-invoice">
                                    <span>▤</span> Xem hóa đơn
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const tabs = document.querySelectorAll('#orderTabs .filter-tab');
            const searchInput = document.getElementById('orderSearchInput');
            const rows = document.querySelectorAll('#ordersTable tbody tr');
            let currentStatus = 'ALL';

            function filterOrders() {
                const keyword = (searchInput?.value || '').toLowerCase().trim();
                rows.forEach(row => {
                    const status = row.getAttribute('data-status') || '';
                    const text = row.innerText.toLowerCase();
                    const matchStatus = currentStatus === 'ALL' || status === currentStatus;
                    const matchKeyword = !keyword || text.includes(keyword);
                    row.style.display = (matchStatus && matchKeyword) ? '' : 'none';
                });
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    currentStatus = tab.getAttribute('data-filter');
                    filterOrders();
                });
            });

            searchInput?.addEventListener('input', filterOrders);
        })();
    </script>
}