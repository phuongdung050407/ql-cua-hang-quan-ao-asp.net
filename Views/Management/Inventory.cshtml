@{ ViewData["Title"]="Kho hàng"; }
<div class="page-heading"><div><p class="eyebrow">KHO HÀNG</p><h1>Quản lý kho</h1></div><button class="primary-button">＋ Nhập kho</button></div>
<div class="stats-grid people-stats"><article class="stat-card"><div class="stat-icon violet">▥</div><div><p>Tổng tồn kho</p><strong>1.248</strong></div></article><article class="stat-card"><div class="stat-icon green">↗</div><div><p>Giá trị kho</p><strong>684 tr</strong></div></article><article class="stat-card"><div class="stat-icon amber">△</div><div><p>Sắp hết hàng</p><strong>12</strong></div></article><article class="stat-card"><div class="stat-icon blue">＋</div><div><p>Nhập kho tháng</p><strong>320</strong></div></article></div>
<section class="panel table-panel"><div class="management-toolbar"><div class="filter-search">⌕ <input placeholder="Tìm mã SKU, sản phẩm..."></div><select><option>Tất cả kho</option><option>Kho miền Bắc</option><option>Kho miền Nam</option></select></div><div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Mã SKU</th><th>Tồn kho</th><th>Đã giữ</th><th>Có thể bán</th><th>Vị trí</th><th></th></tr></thead><tbody>@foreach(var item in ShopProject.Models.ShopDataStore.Inventory){<tr><td><strong>@item.Name</strong></td><td>@item.Sku</td><td><strong>@item.Stock</strong></td><td>@item.Reserved</td><td>@(item.Stock-item.Reserved)</td><td>@item.Location</td><td><form method="post" asp-controller="Management" asp-action="UpdateInventory">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"><input name="stock" type="number" min="0" value="@item.Stock" class="inventory-input"><button type="submit" class="icon-button status-save">Lưu</button></form></td></tr>}</tbody></table></div></section>