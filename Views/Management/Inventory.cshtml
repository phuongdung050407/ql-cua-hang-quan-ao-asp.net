@{ ViewData["Title"]="Kho hàng"; }
<div class="page-heading"><div><p class="eyebrow">KHO HÀNG</p><h1>Quản lý kho</h1></div><button class="primary-button">＋ Nhập kho</button></div>
<div class="stats-grid people-stats"><article class="stat-card"><div class="stat-icon violet">▥</div><div><p>Tổng tồn kho</p><strong>1.248</strong></div></article><article class="stat-card"><div class="stat-icon green">↗</div><div><p>Giá trị kho</p><strong>684 tr</strong></div></article><article class="stat-card"><div class="stat-icon amber">△</div><div><p>Sắp hết hàng</p><strong>12</strong></div></article><article class="stat-card"><div class="stat-icon blue">＋</div><div><p>Nhập kho tháng</p><strong>320</strong></div></article></div>
<section class="panel table-panel"><div class="management-toolbar"><div class="filter-search">⌕ <input placeholder="Tìm mã SKU, sản phẩm..."></div><select><option>Tất cả kho</option><option>Kho miền Bắc</option><option>Kho miền Nam</option></select></div><div class="table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Mã SKU</th><th>Tồn kho</th><th>Đã giữ</th><th>Có thể bán</th><th>Vị trí</th><th></th></tr></thead><tbody>@foreach(var i in new[]{("Áo sơ mi linen","ASM-WHT-M","20","2","18","K1-A3"),("Váy hoa midi","VD-HOA-S","14","3","11","K2-B1"),("Quần jean slim","QJ-BLU-M","3","1","2","K1-C4"),("Áo khoác denim","AK-DEN-L","0","0","0","K3-A1")}){<tr><td><strong>@i.Item1</strong></td><td>@i.Item2</td><td><strong>@i.Item3</strong></td><td>@i.Item4</td><td>@i.Item5</td><td>@i.Item6</td><td><button class="icon-button">⋯</button></td></tr>}</tbody></table></div></section>