@using ShopProject.Controllers
@{
    ViewData["Title"] = "Báo cáo thống kê";
    int currentYear = ViewBag.CurrentYear ?? DateTime.Today.Year;
    int startYear = ViewBag.StartYear ?? currentYear;
    if (startYear > currentYear) startYear = currentYear;

    int selectedYear = ViewBag.SelectedYear ?? currentYear;
    int selectedMonth = ViewBag.SelectedMonth ?? DateTime.Today.Month;
    var data = ViewBag.ReportData as SalesReportSnapshot ?? new SalesReportSnapshot();
    var savedReports = ViewBag.SavedReports as List<SavedReportFileInfo> ?? new();

    var maxMonthRev = data.MonthlyBreakdown.Count > 0 ? data.MonthlyBreakdown.Max(x => x.Revenue) : 0m;
    var maxProdQty = data.TopProducts.Count > 0 ? data.TopProducts.Max(x => x.Stock) : 1;
    var maxCatRev = data.CategorySales.Count > 0 ? data.CategorySales.Max(x => x.Revenue) : 1m;
}

<style>
    .rep-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
    }
    .rep-filter-form {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        padding: 4px 10px;
        border-radius: 10px;
    }
    .rep-filter-form select {
        border: 0;
        background: transparent;
        font-size: 13.5px;
        font-weight: 600;
        color: #0f172a;
        padding: 4px;
        cursor: pointer;
    }
    .btn-outline-rep {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 40px;
        padding: 0 15px;
        border-radius: 10px;
        font-size: 13.5px;
        font-weight: 600;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #1e293b;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-outline-rep:hover {
        border-color: #4f46e5;
        color: #4f46e5;
        background: #f8fafc;
    }
    .kpi-sub {
        display: block;
        font-size: 11.5px;
        color: #64748b;
        margin-top: 2px;
    }
    .kpi-up { color: #15803d; font-weight: 600; }
    .kpi-down { color: #dc2626; font-weight: 600; }

    .chart-grid-2 {
        display: grid;
        grid-template-columns: 1.65fr 1fr;
        gap: 18px;
        margin-bottom: 18px;
    }
    @@media (max-width: 1024px) {
        .chart-grid-2 { grid-template-columns: 1fr; }
    }
    .bar-chart-box {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        align-items: end;
        gap: 8px;
        height: 230px;
        padding: 26px 8px 8px;
        border-bottom: 1px solid #e2e8f0;
        background-image: linear-gradient(to top, #f1f5f9 1px, transparent 1px);
        background-size: 100% 48px;
    }
    .bar-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
        gap: 6px;
        text-decoration: none;
    }
    .bar-val-lbl {
        font-size: 10.5px;
        font-weight: 700;
        color: #475569;
        white-space: nowrap;
    }
    .bar-stick {
        width: 100%;
        max-width: 30px;
        border-radius: 7px 7px 3px 3px;
        background: linear-gradient(180deg, #818cf8 0%, #6366f1 100%);
        transition: all 0.2s ease;
        min-height: 6px;
    }
    .bar-col.is-active .bar-stick {
        background: linear-gradient(180deg, #4f46e5 0%, #312e81 100%);
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
    }
    .bar-col.is-active .bar-val-lbl,
    .bar-col.is-active .bar-m-lbl {
        color: #4f46e5;
        font-weight: 800;
    }
    .bar-m-lbl {
        font-size: 11.5px;
        color: #64748b;
        font-weight: 600;
    }

    .rank-row {
        margin-bottom: 13px;
    }
    .rank-row-head {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        margin-bottom: 5px;
        gap: 8px;
    }
    .rank-track {
        height: 8px;
        background: #f1f5f9;
        border-radius: 999px;
        overflow: hidden;
    }
    .rank-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #6366f1, #4f46e5);
    }

    .status-split-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }
    .st-box {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 12px;
        background: #f8fafc;
    }
    .st-box strong {
        display: block;
        font-size: 18px;
        color: #0f172a;
        margin-top: 2px;
    }

    .act-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 30px;
        padding: 0 11px;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #334155;
    }
    .act-btn:hover { background: #f8fafc; border-color: #cbd5e1; color: #0f172a; }
    .act-primary { color: #4f46e5; border-color: #c7d2fe; background: #eef2ff; }
    .act-danger { color: #dc2626; border-color: #fecaca; background: #fef2f2; }
</style>

<div class="page-heading">
    <div>
        <p class="eyebrow">PHÂN TÍCH & CHỨNG TỪ</p>
        <h1>Báo cáo thống kê — Tháng @selectedMonth/@selectedYear</h1>
    </div>

    <div class="rep-toolbar">
        <form method="get" asp-action="Reports" asp-controller="Management" class="rep-filter-form">
            <span style="font-size:12px;color:#64748b">Kỳ xem:</span>
            <select name="month" onchange="this.form.submit()">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == selectedMonth)">Tháng @m</option>
                }
            </select>
            <span>/</span>
            <select name="year" onchange="this.form.submit()">
                @for (int y = startYear; y <= currentYear; y++)
                {
                    <option value="@y" selected="@(y == selectedYear)">Năm @y</option>
                }
            </select>
        </form>

        <a asp-action="ReportDocument" asp-controller="Management"
           asp-route-year="@selectedYear" asp-route-month="@selectedMonth"
           target="_blank" class="btn-outline-rep">
            📄 Xem chứng từ
        </a>

        <form method="post" asp-action="ExportReportPdf" asp-controller="Management" style="display:inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="year" value="@selectedYear" />
            <input type="hidden" name="month" value="@selectedMonth" />
            <button type="submit" class="primary-button" onclick="setTimeout(() => location.reload(), 1200)">
                ⬇ Xuất & Lưu file PDF
            </button>
        </form>
    </div>
</div>

@if (TempData["ReportSuccess"] != null)
{
    <p style="color:#15803d;margin-bottom:12px;font-weight:500">@TempData["ReportSuccess"]</p>
}

<!-- 1. 4 THẺ CHỈ SỐ KPI CHÍNH -->
<section class="stats-grid" style="margin-bottom:18px">
    <article class="stat-card">
        <div class="stat-icon green">↗</div>
        <div>
            <span>Doanh thu tháng @selectedMonth/@selectedYear</span>
            <strong>@data.MonthRevenue.ToString("N0") đ</strong>
            @if (data.RevenueGrowthPercent.HasValue)
            {
                var g = data.RevenueGrowthPercent.Value;
                <small class="kpi-sub @(g >= 0 ? "kpi-up" : "kpi-down")">
                    @(g >= 0 ? $"▲ +{g}%" : $"▼ {g}%") so với tháng trước
                </small>
            }
            else
            {
                <small class="kpi-sub">Lũy kế năm @selectedYear: @data.YearRevenue.ToString("N0") đ</small>
            }
        </div>
    </article>

    <article class="stat-card">
        <div class="stat-icon blue">▤</div>
        <div>
            <span>Đơn hàng tháng @selectedMonth</span>
            <strong>@data.MonthOrders đơn</strong>
            <small class="kpi-sub">Hoàn tất: @data.CompletedOrders • Đã hủy: @data.CancelledOrders</small>
        </div>
    </article>

    <article class="stat-card">
        <div class="stat-icon purple">♟</div>
        <div>
            <span>Khách hàng mới</span>
            <strong>@data.NewCustomers</strong>
            <small class="kpi-sub">Đăng ký trong tháng @selectedMonth/@selectedYear</small>
        </div>
    </article>

    <article class="stat-card">
        <div class="stat-icon amber">★</div>
        <div>
            <span>Giá trị đơn trung bình</span>
            <strong>@data.AvgOrder.ToString("N0") đ</strong>
            <small class="kpi-sub">Tổng năm @selectedYear: @data.YearOrders đơn</small>
        </div>
    </article>
</section>

<!-- 2. BIỂU ĐỒ DOANH THU 12 THÁNG & TOP SẢN PHẨM BÁN CHẠY -->
<section class="chart-grid-2">
    <article class="panel" style="padding:20px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
            <div>
                <p class="eyebrow" style="margin-bottom:2px">DOANH THU NĂM @selectedYear</p>
                <h3 style="margin:0">Biểu đồ doanh thu theo tháng <small style="font-weight:400;color:#64748b">(Bấm vào cột để xem tháng đó)</small></h3>
            </div>
            <div style="text-align:right">
                <span style="font-size:12px;color:#64748b">Tổng cả năm</span>
                <div style="font-size:16px;font-weight:800;color:#4f46e5">@data.YearRevenue.ToString("N0") đ</div>
            </div>
        </div>

        <div class="bar-chart-box">
            @foreach (var m in data.MonthlyBreakdown)
            {
                var pct = maxMonthRev > 0 ? (int)Math.Round(m.Revenue * 100m / maxMonthRev) : 0;
                var heightPx = m.Revenue > 0 ? Math.Max(18, (int)(pct * 1.45)) : 6;
                var shortLabel = m.Revenue >= 1_000_000m
                    ? $"{(m.Revenue / 1_000_000m):0.##}tr"
                    : (m.Revenue > 0 ? $"{(m.Revenue / 1_000m):0}K" : "0");

                <a asp-action="Reports" asp-controller="Management"
                   asp-route-year="@selectedYear" asp-route-month="@m.Month"
                   class="bar-col @(m.Month == selectedMonth ? "is-active" : "")"
                   title="Tháng @m.Month/@selectedYear: @m.Revenue.ToString("N0") đ (@m.OrderCount đơn)">
                    <span class="bar-val-lbl">@shortLabel</span>
                    <div class="bar-stick" style="height:@(heightPx)px"></div>
                    <span class="bar-m-lbl">T@(m.Month)</span>
                </a>
            }
        </div>
    </article>

    <article class="panel" style="padding:20px">
        <p class="eyebrow" style="margin-bottom:2px">TOP BÁN CHẠY NĂM @selectedYear</p>
        <h3 style="margin:0 0 14px">Sản phẩm đóng góp doanh thu cao</h3>

        @if (data.TopProducts.Count == 0)
        {
            <p style="color:#64748b;font-size:13.5px">Chưa có dữ liệu đơn hàng trong năm @selectedYear.</p>
        }
        else
        {
            @foreach (var p in data.TopProducts)
            {
                var wPct = Math.Max(12, (int)Math.Round(p.Stock * 100.0 / maxProdQty));
                <div class="rank-row">
                    <div class="rank-row-head">
                        <strong style="color:#0f172a">@p.Name</strong>
                        <span style="white-space:nowrap;color:#4f46e5;font-weight:700">@p.Stock sp • @p.Price.ToString("N0")đ</span>
                    </div>
                    <div class="rank-track">
                        <div class="rank-fill" style="width:@(wPct)%"></div>
                    </div>
                </div>
            }
        }
    </article>
</section>

<!-- 3. CƠ CẤU TRẠNG THÁI ĐƠN HÀNG & DOANH THU THEO DANH MỤC -->
<section class="chart-grid-2">
    <article class="panel" style="padding:20px">
        <p class="eyebrow" style="margin-bottom:2px">DOANH THU THEO DANH MỤC (@selectedYear)</p>
        <h3 style="margin:0 0 14px">Tỷ trọng ngành hàng</h3>
        @if (data.CategorySales.Count == 0)
        {
            <p style="color:#64748b;font-size:13.5px">Chưa có dữ liệu danh mục.</p>
        }
        else
        {
            @foreach (var c in data.CategorySales)
            {
                var cPct = maxCatRev > 0 ? Math.Max(10, (int)Math.Round(c.Revenue * 100m / maxCatRev)) : 10;
                <div class="rank-row">
                    <div class="rank-row-head">
                        <strong>@c.CategoryName <small style="color:#64748b;font-weight:400">(@c.UnitsSold sp)</small></strong>
                        <span style="font-weight:700;color:#0f172a">@c.Revenue.ToString("N0") đ</span>
                    </div>
                    <div class="rank-track">
                        <div class="rank-fill" style="width:@(cPct)%;background:linear-gradient(90deg,#10b981,#059669)"></div>
                    </div>
                </div>
            }
        }
    </article>

    <article class="panel" style="padding:20px">
        <p class="eyebrow" style="margin-bottom:2px">TÌNH TRẠNG XỬ LÝ ĐƠN THÁNG @selectedMonth</p>
        <h3 style="margin:0 0 14px">Cơ cấu đơn hàng trong tháng</h3>
        <div class="status-split-grid">
            <div class="st-box" style="border-left:4px solid #16a34a">
                <span style="font-size:12px;color:#15803d;font-weight:600">Đã giao hoàn tất</span>
                <strong>@data.CompletedOrders đơn</strong>
            </div>
            <div class="st-box" style="border-left:4px solid #2563eb">
                <span style="font-size:12px;color:#1d4ed8;font-weight:600">Đang giao hàng</span>
                <strong>@data.ShippingOrders đơn</strong>
            </div>
            <div class="st-box" style="border-left:4px solid #d97706">
                <span style="font-size:12px;color:#b45309;font-weight:600">Chờ / Đã xác nhận</span>
                <strong>@data.PendingOrders đơn</strong>
            </div>
            <div class="st-box" style="border-left:4px solid #dc2626">
                <span style="font-size:12px;color:#b91c1c;font-weight:600">Đã hủy</span>
                <strong>@data.CancelledOrders đơn</strong>
            </div>
        </div>
    </article>
</section>

<!-- 4. KHO LƯU TRỮ FILE BÁO CÁO PDF ĐÃ XUẤT -->
<section class="panel table-panel" style="margin-top:18px">
    <div style="padding:16px 20px;border-bottom:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center">
        <div>
            <h3 style="margin:0;font-size:16px">📁 Hồ sơ báo cáo PDF đã lưu trữ</h3>
            <small style="color:#64748b">Các bản báo cáo sau khi bấm <b>Xuất & Lưu file PDF</b> được lưu tự động tại máy chủ để đối chiếu bất cứ lúc nào.</small>
        </div>
        <span style="font-size:12.5px;color:#4f46e5;font-weight:600">@savedReports.Count bản lưu</span>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Tên file báo cáo PDF</th>
                    <th>Thời gian xuất</th>
                    <th>Dung lượng</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (savedReports.Count == 0)
                {
                    <tr>
                        <td colspan="4" style="text-align:center;color:#64748b;padding:22px">
                            Chưa có file báo cáo nào được lưu. Bấm nút <b>⬇ Xuất & Lưu file PDF</b> ở góc trên để tạo bản lưu đầu tiên.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var f in savedReports)
                    {
                        <tr>
                            <td>
                                <strong style="color:#0f172a">📄 @f.FileName</strong>
                            </td>
                            <td>@f.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@f.SizeKb KB</td>
                            <td>
                                <div style="display:flex;gap:6px">
                                    <a href="@f.Url" target="_blank" class="act-btn act-primary">Xem PDF</a>
                                    <a href="@f.Url" download="@f.FileName" class="act-btn">Tải về</a>
                                    <form method="post" asp-action="DeleteSavedReport" asp-controller="Management" style="display:inline"
                                          onsubmit="return confirm('Xóa bản lưu trữ báo cáo này?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="fileName" value="@f.FileName" />
                                        <button type="submit" class="act-btn act-danger">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>