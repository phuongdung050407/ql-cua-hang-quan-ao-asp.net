@{ ViewData["Title"]="Danh mục"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Danh mục sản phẩm</h1></div><a class="primary-button" asp-controller="Management" asp-action="Products" style="text-decoration:none;display:inline-flex;align-items:center">＋ Quản lý sản phẩm</a></div>
<section class="category-grid">
@foreach(var category in ShopProject.Models.ShopDataStore.Categories)
{
    var count = ShopProject.Models.ShopDataStore.Products.Count(p => p.Category == category.Name);
    <article class="category-card"><b>◫</b><div><strong>@category.Name</strong><span>@count sản phẩm</span></div><em>@category.Status</em></article>
}
</section>