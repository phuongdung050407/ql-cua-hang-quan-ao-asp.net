@{ ViewData["Title"]="Khuyến mãi"; }
<div class="page-heading"><div><p class="eyebrow">MARKETING</p><h1>Khuyến mãi</h1></div><button class="primary-button">＋ Tạo khuyến mãi</button></div>
<div class="stats-grid people-stats"><article class="stat-card"><div class="stat-icon violet">%</div><div><p>Đang hoạt động</p><strong>5</strong></div></article><article class="stat-card"><div class="stat-icon blue">▣</div><div><p>Đã sử dụng</p><strong>328</strong></div></article><article class="stat-card"><div class="stat-icon green">↗</div><div><p>Doanh thu</p><strong>48 tr</strong></div></article><article class="stat-card"><div class="stat-icon amber">◷</div><div><p>Sắp kết thúc</p><strong>2</strong></div></article></div>
<section class="promotion-grid">@foreach(var promotion in ShopProject.Models.ShopDataStore.Promotions){<article class="promotion-card"><div class="promo-top"><span>@promotion.Name.ToUpper()</span><em>@promotion.Status</em></div><h2>@promotion.Name</h2><strong>@promotion.Discount</strong><p>Mã: <b>@promotion.Code</b></p><div><span>@promotion.Period</span><button type="button" class="promotion-detail" data-code="@promotion.Code" data-status="@promotion.Status">Chi tiết</button></div></article>}</section>