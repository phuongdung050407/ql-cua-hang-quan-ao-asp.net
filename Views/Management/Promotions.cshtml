@model List<ShopProject.Models.MaGiamGium>
@{
    ViewData["Title"] = "Khuyến mãi";
    var now = DateTime.Now;
    var dangHoatDong = Model.Count(m => m.TrangThai && m.NgayKetThuc >= now);
    var daSuDung = Model.Sum(m => m.SoLuongDaDung);
    var tongPhatHanh = Model.Sum(m => m.SoLuongPhatHanh);
    var sapKetThuc = Model.Count(m => m.TrangThai && m.NgayKetThuc >= now && m.NgayKetThuc <= now.AddDays(7));
}

<style>
    .promo-form-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 18px 20px;
        margin-bottom: 20px;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
    }
    .promo-form-card.is-edit {
        border-color: #c7d2fe;
        background: #fafbff;
    }
    .promo-form-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(170px, 1fr));
        gap: 12px 14px;
        margin-top: 12px;
    }
    @@media (max-width: 992px) {
        .promo-form-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 576px) {
        .promo-form-grid { grid-template-columns: 1fr; }
    }
    .promo-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
        font-size: 12.5px;
        font-weight: 600;
        color: #334155;
    }
    .promo-field input,
    .promo-field select {
        height: 38px;
        padding: 0 11px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 13px;
        color: #0f172a;
        background: #ffffff;
    }
    .promo-field input:focus,
    .promo-field select:focus {
        outline: none;
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }
    .promo-form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid #f1f5f9;
    }

    .promo-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 16px;
        margin-top: 18px;
    }
    .promo-card-item {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .promo-card-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
    }
    .promo-card-item.is-expired {
        opacity: 0.78;
        background: #fafbfc;
    }
    .promo-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }
    .promo-type-tag {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 3px 9px;
        border-radius: 999px;
        background: #eef2ff;
        color: #4f46e5;
    }
    .promo-st-pill {
        font-size: 11.5px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 999px;
    }
    .promo-st-run {
        background: #dcfce7;
        color: #15803d;
    }
    .promo-st-off {
        background: #fee2e2;
        color: #dc2626;
    }
    .promo-title {
        margin: 6px 0 4px;
        font-size: 16px;
        font-weight: 700;
        color: #0f172a;
    }
    .promo-value {
        font-size: 22px;
        font-weight: 800;
        color: #4f46e5;
        margin-bottom: 8px;
    }
    .promo-code-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .promo-code-box {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f8fafc;
        border: 1px dashed #94a3b8;
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 12.5px;
    }
    .promo-code-box code {
        font-weight: 700;
        color: #0f172a;
        font-size: 13px;
    }
    .promo-copy-btn {
        border: 0;
        background: #e0e7ff;
        color: #3730a3;
        font-size: 11.5px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 6px;
        cursor: pointer;
    }
    .promo-copy-btn:hover {
        background: #c7d2fe;
    }
    .promo-edit-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 30px;
        padding: 0 11px;
        border-radius: 8px;
        border: 1px solid #c7d2fe;
        background: #eef2ff;
        color: #4338ca;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .promo-edit-btn:hover {
        background: #e0e7ff;
        border-color: #a5b4fc;
        color: #312e81;
    }
    .promo-usage-bar {
        height: 6px;
        background: #f1f5f9;
        border-radius: 999px;
        overflow: hidden;
        margin-top: 6px;
    }
    .promo-usage-fill {
        height: 100%;
        background: linear-gradient(90deg, #6366f1, #4f46e5);
        border-radius: 999px;
    }
    .promo-card-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        padding-top: 10px;
        border-top: 1px solid #f1f5f9;
        font-size: 12px;
        color: #64748b;
    }
    .promo-btn-cancel {
        height: 34px;
        padding: 0 14px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }
    .promo-btn-cancel:hover {
        background: #f8fafc;
    }
</style>

<div class="page-heading">
    <div>
        <p class="eyebrow">MARKETING</p>
        <h1>Khuyến mãi</h1>
    </div>
    <button type="button" class="primary-button" onclick="openPromoCreate()">＋ Tạo khuyến mãi</button>
</div>

@if (TempData["PromoSuccess"] != null)
{
    <p style="color:#15803d;margin-bottom:12px;font-weight:600">@TempData["PromoSuccess"]</p>
}
@if (TempData["PromoError"] != null)
{
    <p style="color:#b91c1c;margin-bottom:12px;font-weight:600">@TempData["PromoError"]</p>
}

<!-- KHUNG TẠO MÃ MỚI -->
<section id="addPromoBox" class="promo-form-card" hidden>
    <div style="display:flex;justify-content:space-between;align-items:center">
        <h3 style="margin:0;font-size:16px;color:#0f172a">Tạo mã giảm giá mới</h3>
        <button type="button" class="promo-btn-cancel" onclick="closeAllPromoForms()">✕ Đóng</button>
    </div>

    <form method="post" action="/Management/AddPromotion">
        @Html.AntiForgeryToken()
        <div class="promo-form-grid">
            <label class="promo-field">
                <span>Mã voucher</span>
                <input id="promo-code-input" name="maVoucher" placeholder="VD: SALE50K" required style="text-transform:uppercase" />
            </label>
            <label class="promo-field">
                <span>Tên chương trình</span>
                <input id="promo-name-input" name="moTa" placeholder="Ưu đãi khách hàng" required />
            </label>
            <label class="promo-field">
                <span>Loại giảm</span>
                <select id="promo-type-select" name="loaiGiam">
                    <option value="Phan_tram">Giảm theo %</option>
                    <option value="Tien_mat">Giảm tiền mặt (VNĐ)</option>
                </select>
            </label>
            <label class="promo-field">
                <span>Giá trị giảm</span>
                <input id="promo-value-input" name="giaTri" type="number" min="1" value="15" required />
            </label>
            <label class="promo-field">
                <span>Đơn tối thiểu (VNĐ)</span>
                <input name="donToiThieu" type="number" min="0" step="1000" value="0" />
            </label>
            <label class="promo-field">
                <span>Số lượng phát hành</span>
                <input name="soLuongPhatHanh" type="number" min="1" value="100" required />
            </label>
            <label class="promo-field">
                <span>Ngày bắt đầu</span>
                <input name="ngayBatDau" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </label>
            <label class="promo-field">
                <span>Ngày kết thúc</span>
                <input name="ngayKetThuc" type="date" value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")" required />
            </label>
        </div>

        <div class="promo-form-actions">
            <button type="button" class="promo-btn-cancel" onclick="closeAllPromoForms()">Hủy</button>
            <button type="submit" class="primary-button">Lưu mã khuyến mãi</button>
        </div>
    </form>
</section>

<!-- KHUNG CHỈNH SỬA MÃ KHUYẾN MÃI -->
<section id="editPromoBox" class="promo-form-card is-edit" hidden>
    <div style="display:flex;justify-content:space-between;align-items:center">
        <h3 style="margin:0;font-size:16px;color:#312e81">
            ✎ Chỉnh sửa khuyến mãi: <span id="edit-promo-code-title" style="font-family:monospace"></span>
        </h3>
        <button type="button" class="promo-btn-cancel" onclick="closeAllPromoForms()">✕ Đóng</button>
    </div>

    <form method="post" action="/Management/EditPromotion">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="edit-promo-id" />
        <div class="promo-form-grid">
            <label class="promo-field">
                <span>Mã voucher</span>
                <input name="maVoucher" id="edit-promo-code" required style="text-transform:uppercase" />
            </label>
            <label class="promo-field">
                <span>Tên chương trình</span>
                <input name="moTa" id="edit-promo-desc" required />
            </label>
            <label class="promo-field">
                <span>Loại giảm</span>
                <select name="loaiGiam" id="edit-promo-type">
                    <option value="Phan_tram">Giảm theo %</option>
                    <option value="Tien_mat">Giảm tiền mặt (VNĐ)</option>
                </select>
            </label>
            <label class="promo-field">
                <span>Giá trị giảm</span>
                <input name="giaTri" id="edit-promo-val" type="number" min="1" required />
            </label>
            <label class="promo-field">
                <span>Đơn tối thiểu (VNĐ)</span>
                <input name="donToiThieu" id="edit-promo-min" type="number" min="0" step="1000" />
            </label>
            <label class="promo-field">
                <span>Số lượng phát hành</span>
                <input name="soLuongPhatHanh" id="edit-promo-qty" type="number" min="1" required />
            </label>
            <label class="promo-field">
                <span>Ngày bắt đầu</span>
                <input name="ngayBatDau" id="edit-promo-start" type="date" required />
            </label>
            <label class="promo-field">
                <span>Ngày kết thúc</span>
                <input name="ngayKetThuc" id="edit-promo-end" type="date" required />
            </label>
        </div>

        <div class="promo-form-actions" style="justify-content:space-between;align-items:center">
            <label style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#1e293b;cursor:pointer;margin:0">
                <input type="checkbox" name="trangThai" id="edit-promo-active" value="true" style="width:16px;height:16px" />
                <span>Đang kích hoạt mã</span>
            </label>
            <div style="display:flex;gap:8px">
                <button type="button" class="promo-btn-cancel" onclick="closeAllPromoForms()">Hủy</button>
                <button type="submit" class="primary-button">Cập nhật khuyến mãi</button>
            </div>
        </div>
    </form>
</section>

<div class="stats-grid people-stats">
    <article class="stat-card">
        <div class="stat-icon violet">%</div>
        <div><p>Đang hoạt động</p><strong>@dangHoatDong</strong></div>
    </article>
    <article class="stat-card">
        <div class="stat-icon blue">▣</div>
        <div><p>Đã sử dụng</p><strong>@daSuDung</strong></div>
    </article>
    <article class="stat-card">
        <div class="stat-icon green">↗</div>
        <div><p>Tổng mã phát hành</p><strong>@tongPhatHanh.ToString("N0")</strong></div>
    </article>
    <article class="stat-card">
        <div class="stat-icon amber">◷</div>
        <div><p>Sắp kết thúc</p><strong>@sapKetThuc</strong></div>
    </article>
</div>

@if (Model.Count == 0)
{
    <div class="panel" style="padding:28px;text-align:center;color:#64748b;margin-top:18px">
        Chưa có chương trình khuyến mãi nào. Bấm <b>+ Tạo khuyến mãi</b> để thêm mã đầu tiên.
    </div>
}
else
{
    <section class="promo-cards-grid">
        @foreach (var m in Model)
        {
            var isRunning = m.TrangThai && m.NgayKetThuc >= now;
            var discountLabel = m.LoaiGiam == "Phan_tram"
                ? $"{m.GiaTri:0.#}% OFF"
                : $"GIẢM {m.GiaTri:N0} đ";
            var usagePct = m.SoLuongPhatHanh > 0
                ? Math.Min(100, (int)Math.Round(m.SoLuongDaDung * 100.0 / m.SoLuongPhatHanh))
                : 0;
            var descText = string.IsNullOrWhiteSpace(m.MoTa) ? "Ưu đãi khách hàng" : m.MoTa;

            <article class="promo-card-item @(!isRunning ? "is-expired" : "")">
                <div>
                    <div class="promo-card-head">
                        <span class="promo-type-tag">
                            @(m.LoaiGiam == "Phan_tram" ? "GIẢM PHẦN TRĂM" : "GIẢM TIỀN MẶT")
                        </span>
                        <span class="promo-st-pill @(isRunning ? "promo-st-run" : "promo-st-off")">
                            @(isRunning ? "Đang chạy" : (m.TrangThai ? "Hết hạn" : "Tạm ngưng"))
                        </span>
                    </div>

                    <h2 class="promo-title">@descText</h2>
                    <div class="promo-value">@discountLabel</div>

                    <div class="promo-code-row">
                        <div class="promo-code-box">
                            <span>Mã:</span>
                            <code>@m.MaVoucher</code>
                            <button type="button" class="promo-copy-btn" onclick="copyVoucherCode('@m.MaVoucher', this)">Copy</button>
                        </div>

                        <button type="button"
                                class="promo-edit-btn"
                                data-id="@m.Id"
                                data-code="@m.MaVoucher"
                                data-desc="@descText"
                                data-type="@m.LoaiGiam"
                                data-val="@m.GiaTri.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                data-min="@m.DonToiThieu.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                data-qty="@m.SoLuongPhatHanh"
                                data-start="@m.NgayBatDau.ToString("yyyy-MM-dd")"
                                data-end="@m.NgayKetThuc.ToString("yyyy-MM-dd")"
                                data-active="@m.TrangThai.ToString().ToLower()"
                                onclick="openPromoEdit(this)">
                            <i class="bi bi-pencil-square"></i>
                            <span>Chỉnh sửa</span>
                        </button>
                    </div>

                    <div style="margin-top:12px;font-size:12.5px;color:#475569">
                        <div style="display:flex;justify-content:space-between">
                            <span>Lượt sử dụng</span>
                            <strong>@m.SoLuongDaDung / @m.SoLuongPhatHanh (@usagePct%)</strong>
                        </div>
                        <div class="promo-usage-bar">
                            <div class="promo-usage-fill" style="width:@(usagePct)%"></div>
                        </div>
                    </div>
                </div>

                <div class="promo-card-foot">
                    <span>📅 @m.NgayBatDau.ToString("dd/MM") - @m.NgayKetThuc.ToString("dd/MM/yyyy")</span>
                    <span>Đơn tối thiểu: <b>@m.DonToiThieu.ToString("N0")đ</b></span>
                </div>
            </article>
        }
    </section>
}

<script>
    function closeAllPromoForms() {
        document.getElementById('addPromoBox')?.setAttribute('hidden', '');
        document.getElementById('editPromoBox')?.setAttribute('hidden', '');
    }

    function openPromoCreate() {
        const box = document.getElementById('addPromoBox');
        const wasHidden = box?.hasAttribute('hidden');
        closeAllPromoForms();
        if (box && wasHidden) {
            box.removeAttribute('hidden');
            box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    function openPromoEdit(btn) {
        closeAllPromoForms();
        const d = btn.dataset;
        document.getElementById('edit-promo-id').value = d.id || '';
        document.getElementById('edit-promo-code-title').textContent = d.code || '';
        document.getElementById('edit-promo-code').value = d.code || '';
        document.getElementById('edit-promo-desc').value = d.desc || '';
        document.getElementById('edit-promo-type').value = d.type || 'Phan_tram';
        document.getElementById('edit-promo-val').value = d.val || '0';
        document.getElementById('edit-promo-min').value = d.min || '0';
        document.getElementById('edit-promo-qty').value = d.qty || '1';
        document.getElementById('edit-promo-start').value = d.start || '';
        document.getElementById('edit-promo-end').value = d.end || '';
        document.getElementById('edit-promo-active').checked = (d.active === 'true');

        const box = document.getElementById('editPromoBox');
        box.removeAttribute('hidden');
        box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function copyVoucherCode(code, btn) {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(code).then(() => {
            const oldText = btn.textContent;
            btn.textContent = '✓ Đã copy';
            setTimeout(() => { btn.textContent = oldText; }, 1400);
        });
    }

    window.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const code = params.get('prefillCode');
        const discount = params.get('prefillDiscount');
        const name = params.get('prefillName');

        if (code || discount || name) {
            closeAllPromoForms();
            document.getElementById('addPromoBox')?.removeAttribute('hidden');
            if (code) document.getElementById('promo-code-input').value = code;
            if (name) document.getElementById('promo-name-input').value = name;
            if (discount) document.getElementById('promo-value-input').value = discount;
        }
    });
</script>