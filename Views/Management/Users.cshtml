@model List<ShopProject.Models.NguoiDung>
@{
    ViewData["Title"] = "Người dùng";
    string MapRole(ShopProject.Models.NguoiDung u)
    {
        var code = u.VaiTros.FirstOrDefault()?.MaVaiTro;
        return code switch
        {
            "QUAN_TRI" => "Quản trị viên",
            "NHAN_VIEN" => "Nhân viên",
            _ => "Khách hàng"
        };
    }
}
<div class="page-heading">
    <div>
        <p class="eyebrow">TÀI KHOẢN</p>
        <h1>Người dùng</h1>
    </div>
    <a href="/Shop/Register" class="primary-button">＋ Thêm người dùng</a>
</div>

<section class="panel table-panel">
    <div class="management-toolbar">
        <div class="filter-search">⌕ <input placeholder="Tìm khách hàng..."></div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Người dùng</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var isActive = u.TrangThai == "Hoat_dong";
                    var initial = string.IsNullOrWhiteSpace(u.HoTen) ? "U" : u.HoTen.Trim().Substring(0, 1).ToUpper();
                    <tr>
                        <td>
                            <div class="person-cell">
                                <div>@initial</div>
                                <strong>@u.HoTen</strong>
                            </div>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(u.SoDienThoai) ? "—" : u.SoDienThoai)</td>
                        <td>@u.Email</td>
                        <td>@MapRole(u)</td>
                        <td>
                            <form method="post" action="/Management/UpdateUserStatus" style="display:flex;gap:8px;align-items:center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <select name="trangThai" class="status-select">
                                    <option value="Hoat_dong" selected="@isActive">Hoạt động</option>
                                    <option value="Khoa" selected="@(!isActive)">Tạm khóa</option>
                                </select>
                                <button type="submit" class="icon-button">Lưu</button>
                            </form>
                        </td>
                        <td><span style="font-size:12px;color:#64748b">ID #@u.Id</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>