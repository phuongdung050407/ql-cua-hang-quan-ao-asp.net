@model List<PersonViewModel>
@{
    ViewData["Title"] = "Người dùng";
    var selectedRole = ViewBag.SelectedRole as string ?? "";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">TÀI KHOẢN</p>
        <h1>Người dùng</h1>
    </div>
</div>

@if (TempData["UserSuccess"] != null)
{
    <p style="color:#15803d;margin-bottom:12px">@TempData["UserSuccess"]</p>
}

<form method="get" asp-action="Users" asp-controller="Management" class="management-toolbar">
    <div class="filter-search">
        ⌕ <input name="search" value="@ViewBag.Search" placeholder="Tìm họ tên, email, SĐT...">
    </div>
    <select name="role" onchange="this.form.submit()">
        <option value="">Tất cả vai trò</option>
        <option value="KHACH_HANG" selected="@(selectedRole == "KHACH_HANG")">Khách hàng</option>
        <option value="NHAN_VIEN" selected="@(selectedRole == "NHAN_VIEN")">Nhân viên</option>
        <option value="ADMIN" selected="@(selectedRole == "ADMIN")">Quản trị viên</option>
    </select>
</form>

<section class="panel table-panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Người dùng</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="person-cell">
                                <div>@(string.IsNullOrEmpty(u.Name) ? "U" : u.Name.Substring(0, 1).ToUpper())</div>
                                <strong>@u.Name</strong>
                            </div>
                        </td>
                        <td>@u.Phone</td>
                        <td>@u.Email</td>
                        <td>@u.Role</td>
                        <td>
                            <form method="post" asp-action="UpdateUserStatus" asp-controller="Management" style="display:flex;gap:6px;align-items:center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <select name="status" class="status-select">
                                    <option value="Hoat_dong" selected="@(u.Status == "Hoạt động")">Hoạt động</option>
                                    <option value="Khoa" selected="@(u.Status == "Tạm khóa")">Tạm khóa</option>
                                </select>
                                <button type="submit" class="icon-button">Lưu</button>
                            </form>
                        </td>
                        <td>—</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>