@model List<ShopProject.Models.PersonViewModel>
@{ ViewData["Title"]="Người dùng"; }
<div class="page-heading"><div><p class="eyebrow">TÀI KHOẢN</p><h1>Người dùng</h1></div><a class="primary-button" href="/Shop/Register" style="text-decoration:none;display:inline-flex;align-items:center">＋ Tài khoản mới</a></div>
<div class="management-toolbar"><div class="filter-search">⌕ <input placeholder="Tìm khách hàng..."></div><select><option>Tất cả vai trò</option><option>Khách hàng</option><option>Quản trị viên</option></select></div>
<section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Người dùng</th><th>Số điện thoại</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var person in Model){<tr><td><div class="person-cell"><div>@person.Name.Substring(0,1)</div><strong>@person.Name</strong></div></td><td>@person.Phone</td><td>@person.Email</td><td>@person.Role</td><td><select name="status" class="status-select" data-type="user" data-id="@person.Id" data-current="@person.Status"><option>Hoạt động</option><option>Tạm khóa</option></select></td><td><button type="button" class="icon-button status-save" data-type="user" data-id="@person.Id">Lưu</button></td></tr>}
</tbody></table></div></section>